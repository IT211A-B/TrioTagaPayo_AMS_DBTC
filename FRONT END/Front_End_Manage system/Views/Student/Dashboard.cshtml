@model AMS.ViewModels.StudentDashboardViewModel
@{
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    ViewData["Title"] = "Dashboard";
    ViewData["PageTitle"] = "Student Dashboard";
    ViewData["ActivePage"] = "Dashboard";
}

<div class="welcome-section">
    <h1>Welcome, @Model.StudentName!</h1>
    <p>Here's your attendance overview - @DateTime.Now.ToString("dddd, MMMM d, yyyy")</p>
</div>

<!-- Stats Cards -->
<div class="stats-row">
    <div class="stat-card">
        <div class="stat-icon">📊</div>
        <p class="stat-label">ATTENDANCE RATE</p>
        <p class="stat-value">@Model.AttendanceRate%</p>
        <p class="stat-hint">Overall average</p>
    </div>
    <div class="stat-card">
        <div class="stat-icon">✅</div>
        <p class="stat-label">PRESENT</p>
        <p class="stat-value">@Model.PresentCount</p>
        <p class="stat-hint">Days present</p>
    </div>
    <div class="stat-card">
        <div class="stat-icon">⏰</div>
        <p class="stat-label">LATE</p>
        <p class="stat-value">@Model.LateCount</p>
        <p class="stat-hint">Days late</p>
    </div>
    <div class="stat-card">
        <div class="stat-icon">❌</div>
        <p class="stat-label">ABSENT</p>
        <p class="stat-value">@Model.AbsentCount</p>
        <p class="stat-hint">Days absent</p>
    </div>
</div>

<!-- Quick Actions -->
<div class="quick-actions">
    <a href="@Url.Action("Scanner", "Student")" class="action-btn primary">
        <span class="action-icon">📷</span>
        <span>Scan QR Code</span>
    </a>
    <a href="@Url.Action("AttendanceHistory", "Student")" class="action-btn secondary">
        <span class="action-icon">📋</span>
        <span>View History</span>
    </a>
    <a href="@Url.Action("MyCourses", "Student")" class="action-btn secondary">
        <span class="action-icon">📚</span>
        <span>My Courses</span>
    </a>
</div>

<!-- My Courses Section -->
<div class="section-header">
    <span class="section-title">MY COURSES</span>
</div>

<div class="courses-grid">
    @if (Model.MyCourses.Any())
    {
        foreach (var course in Model.MyCourses)
        {
            <div class="course-card">
                <div class="course-code">@course.CourseCode</div>
                <h3 class="course-name">@course.CourseName</h3>
                <p class="course-info">Section: @course.Section</p>
            </div>
        }
    }
    else
    {
        <div class="empty-state">
            <span class="empty-icon">📚</span>
            <p class="empty-title">No courses yet</p>
            <p class="empty-message">Scan an enrollment QR code from your teacher to join a course.</p>
        </div>
    }
</div>

<!-- Recent Attendance -->
<div class="section-header">
    <span class="section-title">RECENT ATTENDANCE</span>
    <a href="@Url.Action("AttendanceHistory", "Student")" class="section-link">VIEW ALL →</a>
</div>

<div class="table-wrapper">
    <table class="data-table">
        <thead>
            <tr>
                <th>Course</th>
                <th>Date</th>
                <th>Status</th>
                <th>Remarks</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.RecentAttendance.Any())
            {
                foreach (var a in Model.RecentAttendance)
                {
                    <tr>
                        <td>@a.CourseName</td>
                        <td>@a.Date</td>
                        <td>
                            <span class="status-badge @(a.Status == "Present" ? "badge-active" : a.Status == "Late" ? "badge-warning" : "badge-inactive")">
                                @a.Status
                            </span>
                        </td>
                        <td>@(string.IsNullOrEmpty(a.Remarks) ? "—" : a.Remarks)</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="empty-row">No attendance records yet. Scan a QR code to get started.</td>
                </tr>
            }
        </tbody>
    </table>
</div>