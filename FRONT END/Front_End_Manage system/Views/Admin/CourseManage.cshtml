@model AMS.ViewModels.CourseViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Course Management";
    ViewData["PageTitle"] = "Course Management";
    ViewData["ActivePage"] = "Courses";
}
@section PageStyles {
    <link rel="stylesheet" href="~/css/pages/courses.css" />
}

<div class="page-header">
    <div>
        <h2>Course Management</h2>
        <p>Edit course details and assignments</p>
    </div>
    <a href="@Url.Action("Courses", "Admin")" class="btn-secondary">← Back to Courses</a>
</div>

<div class="form-card">
    <form method="post" asp-action="CourseManage" asp-route-id="@Model.DbId">
        @Html.AntiForgeryToken()

        <div class="form-row">
            <div class="form-group">
                <label>Course Code <span class="req">*</span></label>
                <input type="text" name="courseCode" class="form-input" value="@Model.CourseCode" required />
            </div>
            <div class="form-group">
                <label>Units <span class="req">*</span></label>
                <input type="number" name="units" class="form-input" value="@Model.Units" min="1" max="10" required />
            </div>
        </div>

        <div class="form-group">
            <label>Course Name <span class="req">*</span></label>
            <input type="text" name="courseName" class="form-input" value="@Model.CourseName" required />
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>Section <span class="req">*</span></label>
                <input type="text" name="section" class="form-input" value="@Model.Section" required />
            </div>
            <div class="form-group">
                <label>Schedule <span class="req">*</span></label>
                <input type="text" name="schedule" class="form-input" value="@Model.Schedule" required />
            </div>
        </div>

        <div class="form-group">
            <label>Teacher <span class="req">*</span></label>
            <select name="teacherId" class="form-select" required>
                <option value="">— Select Teacher —</option>
                @if (ViewBag.Teachers != null && ViewBag.Teachers.Count > 0)
                {
                    foreach (var t in ViewBag.Teachers)
                    {
                        if (t.Id == Model.TeacherId)
                        {
                            <option value="@t.Id" selected>@t.Name (@t.TeacherNo)</option>
                        }
                        else
                        {
                            <option value="@t.Id">@t.Name (@t.TeacherNo)</option>
                        }
                    }
                }
            </select>
        </div>

        <div class="modal-footer" style="margin-top: 20px; padding: 0;">
            <a href="@Url.Action("Courses", "Admin")" class="btn-secondary">Cancel</a>
            <button type="submit" class="btn-primary">Save Changes</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.querySelector('form')?.addEventListener('submit', function(e) {
            var courseCode = document.querySelector('input[name="courseCode"]')?.value.trim();
            var courseName = document.querySelector('input[name="courseName"]')?.value.trim();
            var section = document.querySelector('input[name="section"]')?.value.trim();
            var schedule = document.querySelector('input[name="schedule"]')?.value.trim();
            var teacherId = document.querySelector('select[name="teacherId"]')?.value;

            if (!courseCode || !courseName || !section || !schedule || !teacherId) {
                e.preventDefault();
                if (typeof Toast !== 'undefined') Toast.warning('Please fill in all required fields.');
            }
        });
    </script>
}