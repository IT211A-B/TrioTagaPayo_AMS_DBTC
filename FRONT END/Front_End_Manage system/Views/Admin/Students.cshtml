@model AMS.ViewModels.StudentsPageViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Students";
    ViewData["PageTitle"] = "Students";
    ViewData["ActivePage"] = "Students";
}
@section PageStyles {
    <link rel="stylesheet" href="~/css/pages/students.css" />
}

<div class="page-header">
    <div>
        <h2>Students</h2>
        <p>Manage student records and profiles</p>
    </div>
    <div class="page-header-actions">
        <button class="btn-primary" onclick="openAddModal()">+ Add Student</button>
    </div>
</div>

<div class="summary-bar">
    <div class="summary-pill">
        <span class="pill-dot dot-blue"></span>
        Total: <strong id="totalCount">@Model.TotalCount</strong>
    </div>
</div>

<div class="filter-bar">
    <div class="search-wrapper">
        <svg class="search-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="10" cy="10" r="7" />
            <path d="M21 21L15 15" />
        </svg>
        <input type="text" id="searchInput" class="search-input" placeholder="Search students..." />
    </div>
    <select id="sectionFilter" class="filter-select">
        <option value="">All Sections</option>
        @if (ViewBag.Sections != null)
        {
            foreach (var item in ViewBag.Sections)
            {
                <option value="@item">@item</option>
            }
        }
    </select>
    <select id="statusFilter" class="filter-select">
        <option value="">All Status</option>
        <option value="Active">Active</option>
        <option value="Inactive">Inactive</option>
        <option value="Probation">Probation</option>
    </select>
</div>

<div class="table-wrapper">
    <table class="data-table">
        <thead>
            <tr>
                <th>Student</th>
                <th class="hide-sm">ID No.</th>
                <th class="hide-sm">Course</th>
                <th class="hide-md">Year</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="studentsBody">
            @if (Model.Students.Any())
            {
                foreach (var s in Model.Students)
                {
                    <tr class="table-row" id="row-@s.DbId"
                        data-id="@s.DbId"
                        data-studentno="@s.StudentNo"
                        data-firstname="@s.FirstName"
                        data-middlename="@s.MiddleName"
                        data-lastname="@s.LastName"
                        data-fullname="@s.FullName"
                        data-email="@s.Email"
                        data-section="@s.Section"
                        data-mobile="@s.MobileNo">
                        <td>
                            <div class="student-cell">
                                <div class="avatar" style="background:@s.AvatarColor">@s.Initials</div>
                                <div>
                                    <p class="cell-name">@s.FullName</p>
                                    <p class="cell-sub">@s.Email</p>
                                </div>
                            </div>
                        </td>
                        <td class="hide-sm"><span class="id-badge">@s.StudentNo</span></td>
                        <td class="hide-sm">@s.Section</td>
                        <td class="hide-md">1st Year</td>
                        <td><span class="status-badge badge-active">Active</span></td>
                        <td>
                            <div class="action-btns">
                                <button class="btn-sm btn-view" onclick="viewStudent(this)">View</button>
                                <button class="btn-sm btn-edit" onclick="editStudent(this)">Edit</button>
                                <button class="btn-sm btn-delete" onclick="confirmDelete(this)">Delete</button>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6">
                        <div class="empty-state">
                            <span class="empty-icon">◍</span>
                            <p class="empty-title">No students found</p>
                            <p class="empty-message">Click "+ Add Student" to get started.</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="pagination-info">
    Showing <span id="showingStart">1</span>-<span id="showingEnd">@Model.Students.Count</span>
    of <span id="totalRecords">@Model.TotalCount</span> students
</div>

<!-- Add / Edit Modal -->
<div class="modal-overlay" id="studentModal">
    <div class="modal-card">
        <div class="modal-header">
            <h3 id="modalTitle">Add Student</h3>
            <button class="modal-close" onclick="closeModal('studentModal')">&times;</button>
        </div>
        <div class="modal-body">
            @Html.AntiForgeryToken()
            <input type="hidden" id="dbId" />
            <input type="hidden" id="studentNo" />
            <div class="form-row">
                <div class="form-group">
                    <label>First Name <span class="req">*</span></label>
                    <input type="text" id="firstName" class="form-input" placeholder="e.g. Maria" required />
                </div>
                <div class="form-group">
                    <label>Last Name <span class="req">*</span></label>
                    <input type="text" id="lastName" class="form-input" placeholder="e.g. Santos" required />
                </div>
            </div>
            <div class="form-group">
                <label>Middle Name</label>
                <input type="text" id="middleName" class="form-input" placeholder="Optional" />
            </div>
            <div class="form-group">
                <label>Email <span class="req">*</span></label>
                <input type="email" id="email" class="form-input" placeholder="student@school.edu" required />
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Section <span class="req">*</span></label>
                    <input type="text" id="section" class="form-input" placeholder="e.g. CS101" required />
                </div>
                <div class="form-group">
                    <label>Mobile No</label>
                    <input type="text" id="mobileNo" class="form-input" placeholder="09XX-XXX-XXXX" />
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn-secondary" onclick="closeModal('studentModal')">Cancel</button>
            <button class="btn-primary" id="saveBtn" onclick="submitStudent()">Save Student</button>
        </div>
    </div>
</div>

<!-- View Modal -->
<div class="modal-overlay" id="viewModal">
    <div class="modal-card">
        <div class="modal-header">
            <h3>Student Profile</h3>
            <button class="modal-close" onclick="closeModal('viewModal')">&times;</button>
        </div>
        <div class="modal-body" id="viewBody"></div>
        <div class="modal-footer">
            <button class="btn-primary" onclick="closeModal('viewModal')">Close</button>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal-overlay" id="deleteModal">
    <div class="modal-card modal-sm">
        <div class="modal-header">
            <h3>Delete Student</h3>
            <button class="modal-close" onclick="closeModal('deleteModal')">&times;</button>
        </div>
        <div class="modal-body">
            <p>Are you sure you want to delete <strong id="deleteName"></strong>? This cannot be undone.</p>
        </div>
        <div class="modal-footer">
            <button class="btn-secondary" onclick="closeModal('deleteModal')">Cancel</button>
            <button class="btn-danger" id="confirmDeleteBtn" onclick="submitDelete()">Yes, Delete</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/students.js"></script>
}