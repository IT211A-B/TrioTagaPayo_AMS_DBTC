@{
    string userRole = Context.Session.GetString("UserRole") ?? "";
    string userName = Context.Session.GetString("UserName") ?? "User";

    // Build initials from the name (e.g. "Mr. Armanes C. Artajo" → "AA")
    string initials = "";
    var nameParts = userName.Split(' ');
    foreach (var part in nameParts)
    {
        if (part.Length > 0 && char.IsLetter(part[0]))
            initials += part[0];
        if (initials.Length == 2) break;
    }
    initials = initials.ToUpper();

    // Current action name — used to highlight the active nav item
    string action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — 3TagaPayu 
    
    </title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="app-body">

    <div class="app-shell">

        <!-- =============================================
             SIDEBAR
             ============================================= -->
        <nav class="sidebar">

            <!-- Logo + system name -->
            <div class="sidebar-brand">
                <div class="sidebar-logo">
                    <img src="~/images/logo.png" alt="Logo" />
                </div>
                <div class="sidebar-brand-text">
                    <span class="brand-name">3TagaPayu ASM</span>
                    <span class="brand-tagline">Attendance System</span>
                </div>
            </div>

            <!-- Nav links — different for Admin vs Teacher -->
            <div class="sidebar-nav">
                <p class="nav-label">Navigation</p>

                @if (userRole == "Admin")
                {
                    <a href="/Admin/Attendance" class="nav-item @(action == "Attendance" ? "active" : "")">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <rect x="3" y="4" width="18" height="18" rx="2" />
                            <path d="M16 2v4M8 2v4M3 10h18M9 16l2 2 4-4" />
                        </svg>
                        Attendance
                    </a>
                    <a href="/Admin/Courses" class="nav-item @(action == "Courses" ? "active" : "")">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
                        </svg>
                        Courses
                    </a>
                    <a href="/Admin/Students" class="nav-item @(action == "Students" ? "active" : "")">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                            <circle cx="9" cy="7" r="4" />
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
                        </svg>
                        Students
                    </a>
                    <a href="/Admin/Teachers" class="nav-item @(action == "Teachers" ? "active" : "")">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <rect x="2" y="3" width="20" height="14" rx="2" />
                            <path d="M8 21h8M12 17v4" />
                        </svg>
                        Teachers
                    </a>
                }
                else
                {
                    <a href="/Teacher/Attendance" class="nav-item @(action == "Attendance" ? "active" : "")">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <rect x="3" y="4" width="18" height="18" rx="2" />
                            <path d="M16 2v4M8 2v4M3 10h18M9 16l2 2 4-4" />
                        </svg>
                        Attendance
                    </a>
                    <a href="/Teacher/MyCourses" class="nav-item @(action == "MyCourses" ? "active" : "")">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
                        </svg>
                        My Courses
                    </a>
                    <a href="/Teacher/MyStudents" class="nav-item @(action == "MyStudents" ? "active" : "")">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                            <circle cx="9" cy="7" r="4" />
                        </svg>
                        My Students
                    </a>
                    <a href="/Teacher/Records" class="nav-item @(action == "Records" ? "active" : "")">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
                        </svg>
                        Att. Records
                    </a>
                }
            </div>

            <!-- User card + logout at the very bottom -->
            <div class="sidebar-footer">
                <div class="user-card">
                    <div class="user-avatar">@initials</div>
                    <div class="user-info">
                        <span class="user-name">@userName</span>
                        <span class="user-role">@userRole</span>
                    </div>
                    <a href="/Account/Logout" class="logout-btn" title="Logout">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                            <polyline points="16 17 21 12 16 7" />
                            <line x1="21" y1="12" x2="9" y2="12" />
                        </svg>
                    </a>
                </div>
            </div>

        </nav>


        <!-- =============================================
             MAIN AREA (topbar + page content + footer)
             ============================================= -->
        <div class="main-area">

            <!-- Top bar -->
            <header class="topbar">
                <span class="topbar-school">DBTC</span>
                <span class="topbar-sep">›</span>
                <span class="topbar-page-title">@ViewData["PageTitle"]</span>

                <div class="topbar-right">
                    <span class="topbar-date" id="topbarDate"></span>
                    <div class="topbar-user-pill">
                        <div class="topbar-avatar">@initials</div>
                        <div>
                            <p class="topbar-user-name">@userName</p>
                            <p class="topbar-user-role">@userRole</p>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Actual page content rendered here -->
            <main class="page-content">
                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="main-footer">
                <span><strong>3TagaPayu ASM</strong> &middot; Don Bosco Technical College, Cebu City</span>
                <span>Academic Year 2025&ndash;2026 &middot; S.Y. Second Semester</span>
            </footer>

        </div>

    </div>

    <script>
        // Show today's date in the topbar automatically
        var months = ['January','February','March','April','May','June',
                      'July','August','September','October','November','December'];
        var today  = new Date();
        document.getElementById('topbarDate').textContent =
            months[today.getMonth()] + ' ' + today.getDate() + ', ' + today.getFullYear();
    </script>

    @RenderSection("Scripts", required: false)

</body>
</html>
