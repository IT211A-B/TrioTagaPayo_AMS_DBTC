@{
    ViewData["Title"] = "Students";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <div>
        <h2>Students</h2>
        <p>All enrolled students this semester</p>
    </div>
    <div class="page-header-actions">
        <button class="btn-secondary" onclick="exportTable()">&#8681; Export</button>
        <button class="btn-primary" onclick="openAddModal()">+ Add Student</button>
    </div>
</div>

<!-- Summary pills -->
<div class="summary-bar">
    <div class="summary-pill">
        <span class="summary-dot dot-blue"></span>
        <span>7 Total Students</span>
    </div>
    <div class="summary-pill">
        <span class="summary-dot dot-green"></span>
        <span>6 Active</span>
    </div>
    <div class="summary-pill">
        <span class="summary-dot dot-red"></span>
        <span>1 Inactive</span>
    </div>
</div>

<!-- Search and filter -->
<div class="table-toolbar" style="background:#fff; border:1px solid var(--border); border-radius:var(--radius-lg); margin-bottom:16px;">
    <input type="text" class="search-input" id="searchInput" placeholder="Search by name or ID..." onkeyup="filterTable()" />
    <select class="filter-select" id="filterYear" onchange="filterTable()">
        <option value="">All Year Levels</option>
        <option value="1st Year">1st Year</option>
        <option value="2nd Year">2nd Year</option>
        <option value="3rd Year">3rd Year</option>
        <option value="4th Year">4th Year</option>
    </select>
    <select class="filter-select" id="filterSection" onchange="filterTable()">
        <option value="">All Sections</option>
        <option value="A">Section A</option>
        <option value="B">Section B</option>
        <option value="C">Section C</option>
    </select>
</div>

