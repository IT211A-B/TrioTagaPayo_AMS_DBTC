<!-- ===================== ADD / EDIT MODAL ===================== -->
<div class="modal-overlay" id="studentModal">
    <div class="modal-box">
        <div class="modal-header">
            <h2 id="modalTitle">Add Student</h2>
            <button class="modal-close" onclick="closeModal()">&#10005;</button>
        </div>
        <div class="modal-body">
            <div class="form-group">
                <label>Student ID</label>
                <input type="text" id="fldId" placeholder="e.g. 2026-0001" />
            </div>
            <div class="form-group">
                <label>Full Name</label>
                <input type="text" id="fldName" placeholder="e.g. Joshua Carl Santos" />
            </div>
            <div class="form-group">
                <label>Email</label>
                <input type="email" id="fldEmail" placeholder="e.g. j.santos@@school.edu" />
            </div>
            <div class="form-group">
                <label>Year Level</label>
                <select id="fldYear">
                    <option value="">-- Select Year --</option>
                    <option>1st Year</option>
                    <option>2nd Year</option>
                    <option>3rd Year</option>
                    <option>4th Year</option>
                </select>
            </div>
            <div class="form-group">
                <label>Section</label>
                <input type="text" id="fldSection" placeholder="e.g. 3TagaPayu" />
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn-secondary" onclick="closeModal()">Cancel</button>
            <button class="btn-primary" onclick="saveModal()">Save Student</button>
        </div>
    </div>
</div>


<!-- ===================== VIEW MODAL ===================== -->
<div class="modal-overlay" id="viewModal">
    <div class="modal-box">
        <div class="modal-header">
            <h2>Student Profile</h2>
            <button class="modal-close" onclick="closeViewModal()">&#10005;</button>
        </div>
        <div class="modal-body">
            <div class="view-student-top">
                <div class="view-avatar" id="viewAvatar">JS</div>
                <div>
                    <div class="view-name" id="viewName">Joshua Carl Santos</div>
                    <div class="view-id" id="viewStudentId">2026-0001</div>
                </div>
            </div>
            <div class="view-details">
                <div class="view-row">
                    <span class="view-label">Year Level</span>
                    <span class="view-value" id="viewYear">3rd Year</span>
                </div>
                <div class="view-row">
                    <span class="view-label">Section</span>
                    <span class="view-value" id="viewSection">3TagaPayu</span>
                </div>
                <div class="view-row">
                    <span class="view-label">Attendance Rate</span>
                    <span class="view-value" id="viewAttend">92%</span>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn-secondary" onclick="closeViewModal()">Close</button>
        </div>
    </div>
</div>


<!-- ===================== DELETE MODAL ===================== -->
<div class="modal-overlay" id="deleteModal">
    <div class="modal-box modal-small">
        <div class="modal-header">
            <h2>Remove Student</h2>
            <button class="modal-close" onclick="closeDeleteModal()">&#10005;</button>
        </div>
        <div class="modal-body">
            <p>Are you sure you want to remove <strong id="deleteName"></strong>? This action cannot be undone.</p>
        </div>
        <div class="modal-footer">
            <button class="btn-secondary" onclick="closeDeleteModal()">Cancel</button>
            <button class="btn-danger-solid" onclick="closeDeleteModal()">Yes, Remove</button>
        </div>
    </div>
</div>


@section Scripts {
    <script>

        // ---- Search & Filter ----
        function filterTable() {
            var search  = document.getElementById("searchInput").value.toLowerCase();
            var year    = document.getElementById("filterYear").value.toLowerCase();
            var section = document.getElementById("filterSection").value.toLowerCase();
            var rows    = document.querySelectorAll("#studentsTable tbody tr");

            rows.forEach(function (row) {
                var text       = row.innerText.toLowerCase();
                var rowYear    = row.cells[2].innerText.toLowerCase();
                var rowSection = row.cells[3].innerText.toLowerCase();

                var okSearch  = text.includes(search);
                var okYear    = year === "" || rowYear.includes(year);
                var okSection = section === "" || rowSection.includes(section);

                row.style.display = (okSearch && okYear && okSection) ? "" : "none";
            });
        }

        // ---- Add Modal ----
        function openAddModal() {
            document.getElementById("modalTitle").innerText = "Add Student";
            document.getElementById("fldId").value      = "";
            document.getElementById("fldName").value    = "";
            document.getElementById("fldEmail").value   = "";
            document.getElementById("fldYear").value    = "";
            document.getElementById("fldSection").value = "";
            document.getElementById("studentModal").classList.add("active");
        }

        // ---- Edit Modal ----
        function openEditModal(id, name, year, section) {
            document.getElementById("modalTitle").innerText = "Edit Student";
            document.getElementById("fldId").value      = id;
            document.getElementById("fldName").value    = name;
            document.getElementById("fldEmail").value   = "";
            document.getElementById("fldYear").value    = year;
            document.getElementById("fldSection").value = section;
            document.getElementById("studentModal").classList.add("active");
        }

        function closeModal() {
            document.getElementById("studentModal").classList.remove("active");
        }

        function saveModal() {
            alert("Student saved! (Connect to your controller here)");
            closeModal();
        }

        // ---- View Modal ----
        function openViewModal(name, id, year, section, attend) {
            var parts    = name.trim().split(" ");
            var initials = parts[0][0] + parts[parts.length - 1][0];

            document.getElementById("viewAvatar").innerText    = initials.toUpperCase();
            document.getElementById("viewName").innerText      = name;
            document.getElementById("viewStudentId").innerText = id;
            document.getElementById("viewYear").innerText      = year;
            document.getElementById("viewSection").innerText   = section;
            document.getElementById("viewAttend").innerText    = attend;
            document.getElementById("viewModal").classList.add("active");
        }

        function closeViewModal() {
            document.getElementById("viewModal").classList.remove("active");
        }

        // ---- Delete Modal ----
        function confirmDelete(name) {
            document.getElementById("deleteName").innerText = name;
            document.getElementById("deleteModal").classList.add("active");
        }

        function closeDeleteModal() {
            document.getElementById("deleteModal").classList.remove("active");
        }

        // ---- Export placeholder ----
        function exportTable() {
            alert("Export feature — connect to your controller here.");
        }

        // ---- Close modal when clicking outside ----
        document.querySelectorAll(".modal-overlay").forEach(function (overlay) {
            overlay.addEventListener("click", function (e) {
                if (e.target === overlay) {
                    overlay.classList.remove("active");
                }
            });
        });

    </script>
}
