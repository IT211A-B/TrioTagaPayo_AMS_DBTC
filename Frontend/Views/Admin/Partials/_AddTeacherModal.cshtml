<div class="modal-overlay" id="addTeacherModal">
    <div class="modal-card">
        <div class="modal-header">
            <h3>Add Teacher</h3>
            <button class="modal-close" onclick="closeModal('addTeacherModal')">×</button>
        </div>
        <div class="modal-body">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label>First Name <span class="req">*</span></label>
                <input type="text" id="addTeacherFirstName" class="form-input" required />
            </div>
            <div class="form-group">
                <label>Last Name <span class="req">*</span></label>
                <input type="text" id="addTeacherLastName" class="form-input" required />
            </div>
            <div class="form-group">
                <label>Email <span class="req">*</span></label>
                <input type="email" id="addTeacherEmail" class="form-input" required />
            </div>
            <div class="info-message">
                <p>⚠️ Username will be auto-generated as: firstname.lastname</p>
                <p>🔑 Default password: <strong>teacher123</strong></p>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn-secondary" onclick="closeModal('addTeacherModal')">Cancel</button>
            <button class="btn-primary" onclick="submitAddTeacher()">Add Teacher</button>
        </div>
    </div>
</div>

<script>
    async function submitAddTeacher() {
        const firstName = document.getElementById('addTeacherFirstName').value.trim();
        const lastName = document.getElementById('addTeacherLastName').value.trim();
        const email = document.getElementById('addTeacherEmail').value.trim();

        if (!firstName || !lastName || !email) {
            if (typeof Toast !== 'undefined') Toast.warning('Please fill in all required fields.');
            return;
        }

        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        const formData = new URLSearchParams();
        formData.append('__RequestVerificationToken', token);
        formData.append('firstName', firstName);
        formData.append('lastName', lastName);
        formData.append('email', email);

        try {
            const response = await fetch('/Admin/AddTeacher', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: formData
            });
            const data = await response.json();
            if (data.success) {
                if (typeof Toast !== 'undefined') Toast.success(data.message);
                if (typeof closeModal === 'function') closeModal('addTeacherModal');
                setTimeout(() => location.reload(), 1500);
            } else {
                if (typeof Toast !== 'undefined') Toast.error(data.message);
            }
        } catch (error) {
            console.error('Error adding teacher:', error);
            if (typeof Toast !== 'undefined') Toast.error('An unexpected error occurred.');
        }
    }
</script>