@* Views/Admin/Attendance.cshtml
   FIX: @model changed from List<AttendanceEntryViewModel>
        to AttendancePageViewModel which wraps the list AND
        adds course dropdown + date range filter support.
   Design is completely unchanged.
*@
@model AMS.ViewModels.AttendancePageViewModel
@using AMS.ViewModels
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Attendance";
    ViewData["PageTitle"] = "Attendance";
}

<div class="page-header">
    <div>
        <h2>Attendance</h2>
        <p>All attendance records</p>
    </div>
</div>

<!-- SUMMARY PILLS -->
<div class="summary-bar">
    <div class="summary-pill"><span class="pill-dot dot-blue"></span>Total: <strong id="pillTotal">@Model.TotalCount</strong></div>
    <div class="summary-pill"><span class="pill-dot dot-green"></span>Present: <strong id="pillPresent">@Model.PresentCount</strong></div>
    <div class="summary-pill"><span class="pill-dot dot-red"></span>Absent: <strong id="pillAbsent">@Model.AbsentCount</strong></div>
    <div class="summary-pill" style="border-color:rgba(234,179,8,0.3)">
        <span class="pill-dot" style="background:#facc15"></span>Late: <strong id="pillLate">@Model.LateCount</strong>
    </div>
</div>

<!-- FILTER BAR — now includes course dropdown + date range -->
<div class="filter-bar" style="flex-wrap:wrap;gap:8px;">
    <input type="text" id="searchInput" class="search-input"
           placeholder="Search by student name or no..." oninput="filterTable()" />

    <select id="statusFilter" class="filter-select" onchange="filterTable()">
        <option value="">All Status</option>
        <option value="Present">Present</option>
        <option value="Absent">Absent</option>
        <option value="Late">Late</option>
    </select>

    <!-- FIX: Course filter dropdown — uses backend GET /api/Attendance/filter -->
    <select id="courseFilter" class="filter-select" onchange="loadFilteredRecords()">
        <option value="">All Courses</option>
        @foreach (var c in Model.Courses)
        {
            if (Model.SelectedCourseId == c.DbId)
            {
                <option value="@c.DbId" selected>@c.CourseName (@c.Section)</option>
            }
            else
            {
                <option value="@c.DbId">@c.CourseName (@c.Section)</option>
            }
        }
    </select>

    <input type="date" id="fromDate" class="filter-input"
           value="@Model.FromDate" onchange="loadFilteredRecords()"
           title="From date" />
    <input type="date" id="toDate" class="filter-input"
           value="@Model.ToDate" onchange="loadFilteredRecords()"
           title="To date" />
</div>

<div class="table-wrapper">
    <table class="data-table" id="attTable">
        <thead>
            <tr>
                <th>Student</th>
                <th class="hide-sm">Student No</th>
                <th>Course</th>
                <th class="hide-md">Date</th>
                <th>Status</th>
                <th class="hide-md">Remarks</th>
            </tr>
        </thead>
        <tbody id="attBody">
            @if (Model.Records.Any())
            {
                @foreach (var a in Model.Records)
                {
                    <tr class="table-row fade-in-row"
                        data-name="@a.StudentName.ToLower()"
                        data-no="@a.StudentNo.ToLower()"
                        data-status="@a.Status">
                        <td><p class="cell-name">@a.StudentName</p></td>
                        <td class="hide-sm"><span class="id-badge">@a.StudentNo</span></td>
                        <td>@a.CourseName</td>
                        <td class="hide-md">@a.Date</td>
                        <td>
                            <span class="status-badge
                                        @(a.Status == "Present" ? "badge-active" :
                                                                    a.Status == "Late" ? "badge-warning" : "badge-inactive")">
                                @a.Status
                            </span>
                        </td>
                        <td class="hide-md">
                            <span class="cell-sub">@(string.IsNullOrEmpty(a.Remarks) ? "—" : a.Remarks)</span>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6">
                        @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel
                        {
                            Icon = "◷",
                                        Title = "No attendance records",
                                        Message = "Attendance records will appear here after students scan in."
                                        })
                </td>
            </tr>
                        }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        // ── Client-side search + status filter ───────────────
        function filterTable() {
            const search = document.getElementById('searchInput').value.toLowerCase();
            const status = document.getElementById('statusFilter').value;

            document.querySelectorAll('#attBody tr.table-row').forEach(row => {
                const name = row.dataset.name || '';
                const no   = row.dataset.no   || '';
                const st   = row.dataset.status || '';

                const matchSearch = !search || name.includes(search) || no.includes(search);
                const matchStatus = !status || st === status;

                row.style.display = (matchSearch && matchStatus) ? '' : 'none';
            });
        }

        // ── Server-side filter by courseId + date range ───────
        // Calls GET /Admin/AttendanceFilter which hits the backend's
        // GET /api/Attendance/filter?courseId=&from=&to= endpoint.
        // Returns a partial view with the filtered rows.
        async function loadFilteredRecords() {
            const courseId = document.getElementById('courseFilter').value;
            const from     = document.getElementById('fromDate').value;
            const to       = document.getElementById('toDate').value;

            // Need courseId AND both dates to use the filter endpoint
            if (!courseId || !from || !to) return;

            try {
                const res  = await fetch(`/Admin/AttendanceFilter?courseId=${courseId}&from=${from}&to=${to}`);
                const html = await res.text();
                document.getElementById('attBody').innerHTML = html || emptyRow();
                updatePills();
            } catch {
                Toast.error('Failed to filter records.');
            }
        }

        function updatePills() {
            const rows    = document.querySelectorAll('#attBody tr.table-row');
            let present = 0, absent = 0, late = 0;
            rows.forEach(r => {
                const s = r.dataset.status;
                if (s === 'Present') present++;
                else if (s === 'Absent') absent++;
                else if (s === 'Late') late++;
            });
            document.getElementById('pillTotal').textContent   = rows.length;
            document.getElementById('pillPresent').textContent = present;
            document.getElementById('pillAbsent').textContent  = absent;
            document.getElementById('pillLate').textContent    = late;
        }

        function emptyRow() {
            return `<tr><td colspan="6" style="text-align:center;padding:40px;color:rgba(255,255,255,0.35)">No records found.</td></tr>`;
        }
    </script>
}
