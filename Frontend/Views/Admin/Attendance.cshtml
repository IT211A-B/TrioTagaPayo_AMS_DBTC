@model List<AMS.ViewModels.AttendanceEntryViewModel>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Attendance";
    ViewData["PageTitle"] = "Attendance";
}

<div class="page-header">
    <div>
        <h2>Attendance</h2>
        <p>All attendance records</p>
    </div>
</div>

<!-- SUMMARY PILLS -->
<div class="summary-bar">
    <div class="summary-pill"><span class="pill-dot dot-blue"></span>Total: <strong>@Model.Count</strong></div>
    <div class="summary-pill"><span class="pill-dot dot-green"></span>Present: <strong>@Model.Count(a => a.Status == "Present")</strong></div>
    <div class="summary-pill"><span class="pill-dot dot-red"></span>Absent: <strong>@Model.Count(a => a.Status == "Absent")</strong></div>
    <div class="summary-pill" style="border-color:rgba(234,179,8,0.3)">
        <span class="pill-dot" style="background:#facc15"></span>Late: <strong>@Model.Count(a => a.Status == "Late")</strong>
    </div>
</div>

<!-- FILTER -->
<div class="filter-bar">
    <input type="text" id="searchInput" class="search-input" placeholder="Search by student name or no..." oninput="filterTable()" />
    <select id="statusFilter" class="filter-select" onchange="filterTable()">
        <option value="">All Status</option>
        <option value="Present">Present</option>
        <option value="Absent">Absent</option>
        <option value="Late">Late</option>
    </select>
</div>

<div class="table-wrapper">
    <table class="data-table" id="attTable">
        <thead>
            <tr>
                <th>Student</th>
                <th class="hide-sm">Student No</th>
                <th>Course</th>
                <th class="hide-md">Date</th>
                <th>Status</th>
                <th class="hide-md">Remarks</th>
            </tr>
        </thead>
        <tbody id="attBody">
            @if (Model.Any())
            {
                @foreach (var a in Model)
                {
                    <tr class="table-row fade-in-row"
                        data-name="@a.StudentName.ToLower()"
                        data-no="@a.StudentNo.ToLower()"
                        data-status="@a.Status">
                        <td><p class="cell-name">@a.StudentName</p></td>
                        <td class="hide-sm"><span class="id-badge">@a.StudentNo</span></td>
                        <td>@a.CourseName</td>
                        <td class="hide-md">@a.Date</td>
                        <td>
                            <span class="status-badge
                                        @(a.Status == "Present" ? "badge-active" :
                                                                    a.Status == "Late" ? "badge-warning" : "badge-inactive")">
                                @a.Status
                            </span>
                        </td>
                        <td class="hide-md">
                            <span class="cell-sub">@(string.IsNullOrEmpty(a.Remarks) ? "—" : a.Remarks)</span>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6">
                        @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel
                        {
                            Icon = "◷",
                                        Title = "No attendance records",
                                        Message = "Attendance records will appear here after students scan in."
                                        })
                </td>
            </tr>
                        }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        // Client-side filter since records are already loaded
        function filterTable() {
            const search = document.getElementById('searchInput').value.toLowerCase();
            const status = document.getElementById('statusFilter').value;

            document.querySelectorAll('#attBody tr.table-row').forEach(row => {
                const name = row.dataset.name || '';
                const no   = row.dataset.no   || '';
                const st   = row.dataset.status || '';

                const matchSearch = !search || name.includes(search) || no.includes(search);
                const matchStatus = !status || st === status;

                row.style.display = (matchSearch && matchStatus) ? '' : 'none';
            });
        }
    </script>
}
