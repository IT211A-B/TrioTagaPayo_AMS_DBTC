@model AMS.ViewModels.DashboardViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Dashboard";
    ViewData["PageTitle"] = "Dashboard";
}

<!-- STAT CARDS -->
<div class="stats-row">
    <div class="stat-card">
        <p class="stat-label">Total Students</p>
        <p class="stat-value">@Model.TotalStudents</p>
        <p class="stat-hint">Enrolled this semester</p>
    </div>
    <div class="stat-card">
        <p class="stat-label">Total Teachers</p>
        <p class="stat-value">@Model.TotalTeachers</p>
        <p class="stat-hint">Active faculty</p>
    </div>
    <div class="stat-card">
        <p class="stat-label">Total Courses</p>
        <p class="stat-value">@Model.TotalCourses</p>
        <p class="stat-hint">This semester</p>
    </div>
    <div class="stat-card">
        <p class="stat-label">Attendance Rate</p>
        <p class="stat-value">@Model.AttendanceRate%</p>
        <p class="stat-hint">Present records</p>
    </div>
</div>

<!-- QUICK LINKS -->
<div class="quick-links">
    <a href="@Url.Action("Students", "Admin")" class="quick-link">
        <span class="ql-icon">◍</span><span>Students</span>
    </a>
    <a href="@Url.Action("Teachers", "Admin")" class="quick-link">
        <span class="ql-icon">◈</span><span>Teachers</span>
    </a>
    <a href="@Url.Action("Courses", "Admin")" class="quick-link">
        <span class="ql-icon">◧</span><span>Courses</span>
    </a>
    <a href="@Url.Action("Attendance", "Admin")" class="quick-link">
        <span class="ql-icon">◷</span><span>Attendance</span>
    </a>
</div>

<!-- RECENT ATTENDANCE -->
<div class="section-header">
    <h3 class="section-title">Recent Attendance</h3>
</div>

<div class="table-wrapper">
    <table class="data-table">
        <thead>
            <tr>
                <th>Student</th>
                <th class="hide-sm">Student No</th>
                <th class="hide-sm">Course</th>
                <th>Date</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.RecentAttendance.Any())
            {
                @foreach (var a in Model.RecentAttendance)
                {
                    <tr class="table-row">
                        <td><p class="cell-name">@a.StudentName</p></td>
                        <td class="hide-sm"><span class="id-badge">@a.StudentNo</span></td>
                        <td class="hide-sm">@a.CourseName</td>
                        <td>@a.Date</td>
                        <td>
                            <span class="status-badge
                                        @(a.Status == "Present" ? "badge-active" :
                                                                    a.Status == "Late" ? "badge-warning" : "badge-inactive")">
                                @a.Status
                            </span>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5">
                        @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel
                        {
                            Icon = "◷",
                                        Title = "No attendance records yet",
                                        Message = "Records will appear here once students start scanning in."
                                        })
                </td>
            </tr>
                        }
        </tbody>
    </table>
</div>
