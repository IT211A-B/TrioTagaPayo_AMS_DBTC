@model ASM.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h2>Dashboard</h2>
        <p>Welcome back! Here's what's happening today.</p>
    </div>
</div>

<!-- ===================== STAT CARDS ===================== -->
<div class="stats-row">

    <div class="stat-card">
        <p class="stat-label">Total Students</p>
        <p class="stat-value">@Model.TotalStudents</p>
        <p class="stat-sub">Enrolled this semester</p>
        <span class="stat-pill pill-blue">&#127891; Students</span>
    </div>

    <div class="stat-card">
        <p class="stat-label">Total Teachers</p>
        <p class="stat-value">@Model.TotalTeachers</p>
        <p class="stat-sub">Active faculty members</p>
        <span class="stat-pill pill-green">&#128218; Faculty</span>
    </div>

    <div class="stat-card">
        <p class="stat-label">Total Courses</p>
        <p class="stat-value">@Model.TotalCourses</p>
        <p class="stat-sub">Offered this semester</p>
        <span class="stat-pill pill-blue">&#128196; Courses</span>
    </div>

    <div class="stat-card">
        <p class="stat-label">Attendance Rate</p>
        <p class="stat-value">@Model.AttendanceRate</p>
        <p class="stat-sub">Overall this week</p>
        <span class="stat-pill pill-green">&#128197; This week</span>
    </div>

</div>


<!-- ===================== TWO COLUMNS ===================== -->
<div class="grid-2">

    <!-- Left — Recent Attendance -->
    <div class="card">
        <div class="card-header">
            <span class="card-title">Recent Attendance</span>
            <span class="card-badge">Today</span>
        </div>
        <div class="card-body" style="padding: 0;">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Student ID</th>
                        <th>Name</th>
                        <th>Section</th>
                        <th>Time In</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in Model.RecentAttendance)
                    {
                        <tr>
                            <td class="table-id">@entry.StudentId</td>
                            <td><strong>@entry.StudentName</strong></td>
                            <td><span class="table-section">@entry.Section</span></td>
                            <td class="table-id">@entry.TimeIn</td>
                            <td>
                                <div class="status-badge status-@entry.Status">@entry.Status</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Right — Quick Links -->
    <div class="card">
        <div class="card-header">
            <span class="card-title">Quick Links</span>
        </div>
        <div class="card-body">
            <div class="quick-links">

                <a href="/Admin/Students" class="quick-link-item">
                    <div class="quick-link-icon icon-blue">&#127891;</div>
                    <div>
                        <div class="quick-link-title">Manage Students</div>
                        <div class="quick-link-sub">View, add, or edit students</div>
                    </div>
                    <span class="quick-link-arrow">&#8250;</span>
                </a>

                <a href="/Admin/Teachers" class="quick-link-item">
                    <div class="quick-link-icon icon-green">&#128218;</div>
                    <div>
                        <div class="quick-link-title">Manage Teachers</div>
                        <div class="quick-link-sub">View, add, or edit teachers</div>
                    </div>
                    <span class="quick-link-arrow">&#8250;</span>
                </a>

                <a href="/Admin/Courses" class="quick-link-item">
                    <div class="quick-link-icon icon-amber">&#128196;</div>
                    <div>
                        <div class="quick-link-title">Manage Courses</div>
                        <div class="quick-link-sub">View, add, or edit courses</div>
                    </div>
                    <span class="quick-link-arrow">&#8250;</span>
                </a>

                <a href="/Admin/Attendance" class="quick-link-item">
                    <div class="quick-link-icon icon-red">&#128197;</div>
                    <div>
                        <div class="quick-link-title">View Attendance</div>
                        <div class="quick-link-sub">Check today's attendance logs</div>
                    </div>
                    <span class="quick-link-arrow">&#8250;</span>
                </a>

            </div>
        </div>
    </div>

</div>
