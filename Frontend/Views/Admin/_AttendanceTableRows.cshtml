@model List<AMS.ViewModels.AttendanceEntryViewModel>

@if (Model != null && Model.Any())
{
    @foreach (var a in Model)
    {
        <tr class="table-row fade-in-row"
            data-name="@a.StudentName?.ToLower()"
            data-no="@a.StudentNo?.ToLower()"
            data-status="@a.Status">
            <td>
                <div class="student-cell">
                    <div class="avatar" style="background:linear-gradient(135deg,#d81b60,#9c1040);">
                        @(a.StudentName?.Length > 0 ? a.StudentName[0].ToString().ToUpper() : "?")
                    </div>
                    <div>
                        <p class="cell-name">@a.StudentName</p>
                        <p class="cell-sub">@a.CourseName</p>
                    </div>
                </div>
            </td>
            <td class="hide-sm"><span class="id-badge">@a.StudentNo</span></td>
            <td class="hide-sm">@a.CourseName</td>
            <td class="hide-md">@a.Date</td>
            <td>
                <span class="status-badge
                            @(a.Status == "Present" ? "badge-active" : a.Status == "Late" ? "badge-warning" : "badge-inactive")">
                    ● @a.Status
                </span>
            </td>
            <td class="hide-md">
                <span class="cell-sub">@(string.IsNullOrEmpty(a.Remarks) ? "—" : a.Remarks)</span>
            </td>
        </tr>
    }
}