@model AMS.ViewModels.CoursesPageViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Courses";
    ViewData["PageTitle"] = "Courses";
    ViewData["ActivePage"] = "Courses";
}

@{
    var hasCourses = Model.Courses.Any();
    var searchValue = Model.Search ?? "";
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/pages/courses.css" />
}

<div class="page-header">
    <div>
        <h2>Courses</h2>
        <p>Manage subject offerings and assignments</p>
    </div>
    <button class="btn-primary" onclick="openAddModal()">+ Add Course</button>
</div>

<div class="filter-bar">
    <div class="search-wrapper">
        <svg class="search-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="10" cy="10" r="7" />
            <path d="M21 21L15 15" />
        </svg>
        <input type="text" id="searchInput" class="search-input" placeholder="Search courses..." value="@searchValue" oninput="filterCourses()" />
    </div>
</div>

<div class="courses-grid" id="coursesGrid">
    @if (hasCourses)
    {
        foreach (var c in Model.Courses)
        {
            var courseName = c.CourseName ?? "";
            var courseCode = c.CourseCode ?? "";
            var courseSection = c.Section ?? "";
            var courseSchedule = c.Schedule ?? "";
            var courseUnits = c.Units;
            var courseTeacher = c.TeacherName ?? "";
            var courseId = c.DbId;

            <div class="course-card" data-name="@courseName.ToLower()" data-code="@courseCode.ToLower()" data-id="@courseId">
                <div class="course-card-header">
                    <div class="course-code">@courseCode</div>
                    <div class="course-actions-dropdown">
                        <button class="dropdown-btn" onclick="toggleDropdown(this)">⋯</button>
                        <div class="dropdown-menu">
                            <button onclick="viewCourse(@courseId,'@Html.Raw(courseName)','@courseCode','@courseSection','@Html.Raw(courseSchedule)','@courseUnits','@Html.Raw(courseTeacher)')">View</button>
                            <button onclick="editCourse(@courseId,'@courseCode','@Html.Raw(courseName)','@courseUnits','@courseSection','@Html.Raw(courseSchedule)','@c.TeacherId')">Edit</button>
                            <button onclick="confirmDelete(@courseId,'@Html.Raw(courseName)')">Delete</button>
                        </div>
                    </div>
                </div>
                <div class="course-card-body">
                    <h3 class="course-name">@courseName</h3>
                    <p class="course-teacher">@courseTeacher</p>
                    <div class="course-details">
                        <span class="course-schedule">📅 @courseSchedule</span>
                        <span class="course-section">📚 @courseSection</span>
                        <span class="course-units">⚡ @courseUnits units</span>
                    </div>
                </div>
                <div class="course-card-footer">
                    <span class="student-count">👥 0 Students</span>
                    <div class="action-btns">
                        <button class="btn-sm btn-view" onclick="viewCourseDetails(@courseId)">Details</button>
                        <button class="btn-manage" onclick="manageCourse(@courseId)">Manage</button>
                        <button class="btn-sm btn-primary" onclick="generateAttendanceQR(@courseId, '@Html.Raw(courseName)')">📱 Attendance QR</button>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="empty-state">
            <span class="empty-icon">◧</span>
            <p class="empty-title">No courses found</p>
            <p class="empty-message">Try a different search or add a new course.</p>
        </div>
    }
</div>

<div class="modal-overlay" id="courseModal">
    <div class="modal-card">
        <div class="modal-header">
            <h3 id="modalTitle">Add Course</h3>
            <button class="modal-close" onclick="closeModal('courseModal')">×</button>
        </div>
        <div class="modal-body">
            @Html.AntiForgeryToken()
            <input type="hidden" id="dbId" />
            <div class="form-row">
                <div class="form-group">
                    <label>Course Code <span class="req">*</span></label>
                    <input type="text" id="courseCode" class="form-input" placeholder="e.g. CS101" required />
                </div>
                <div class="form-group">
                    <label>Units <span class="req">*</span></label>
                    <input type="number" id="units" class="form-input" value="3" min="1" max="10" required />
                </div>
            </div>
            <div class="form-group">
                <label>Course Name <span class="req">*</span></label>
                <input type="text" id="courseName" class="form-input" placeholder="e.g. Introduction to Computing" required />
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Section <span class="req">*</span></label>
                    <input type="text" id="section" class="form-input" placeholder="e.g. 3TagaPayu" required />
                </div>
                <div class="form-group">
                    <label>Schedule <span class="req">*</span></label>
                    <input type="text" id="schedule" class="form-input" placeholder="e.g. Mon/Wed 8:00-10:00 AM" required />
                </div>
            </div>
            <div class="form-group">
                <label>Teacher <span class="req">*</span></label>
                <select id="teacherId" class="form-input" required>
                    <option value="">— Select Teacher —</option>
                    @if (Model.Teachers != null)
                    {
                        var uniqueTeachers = Model.Teachers
                        .GroupBy(t => t.TeacherNo)
                        .Select(g => g.First())
                        .ToList();
                        foreach (var t in uniqueTeachers)
                        {
                            <option value="@t.DbId">@t.FullName (@t.TeacherNo)</option>
                        }
                    }
                </select>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn-secondary" onclick="closeModal('courseModal')">Cancel</button>
            <button class="btn-primary" id="saveBtn" onclick="submitCourse()">Save Course</button>
        </div>
    </div>
</div>

<div class="modal-overlay" id="viewModal">
    <div class="modal-card">
        <div class="modal-header">
            <h3>Course Details</h3>
            <button class="modal-close" onclick="closeModal('viewModal')">×</button>
        </div>
        <div class="modal-body" id="viewBody"></div>
        <div class="modal-footer">
            <button class="btn-primary" onclick="closeModal('viewModal')">Close</button>
        </div>
    </div>
</div>

<div class="modal-overlay" id="deleteModal">
    <div class="modal-card modal-sm">
        <div class="modal-header">
            <h3>Delete Course</h3>
            <button class="modal-close" onclick="closeModal('deleteModal')">×</button>
        </div>
        <div class="modal-body">
            <p>Are you sure you want to delete <strong id="deleteName"></strong>? This cannot be undone.</p>
        </div>
        <div class="modal-footer">
            <button class="btn-secondary" onclick="closeModal('deleteModal')">Cancel</button>
            <button class="btn-danger" id="confirmDeleteBtn" onclick="submitDelete()">Yes, Delete</button>
        </div>
    </div>
</div>

<div class="modal-overlay" id="qrModal">
    <div class="modal-card">
        <div class="modal-header">
            <h3>Course Attendance QR</h3>
            <button class="modal-close" id="closeQrModalBtn">×</button>
        </div>
        <div class="modal-body" style="text-align: center;">
            @Html.AntiForgeryToken()
            <div id="qrImageContainer" style="margin: 20px 0; min-height: 200px;">
                <div class="spinner-ring"></div>
            </div>
            <p><strong>Course:</strong> <span id="qrCourseName"></span></p>
            <p style="font-size: 12px; color: #64748b;">Students scan this QR to mark attendance</p>
            <p style="font-size: 12px; color: #64748b;">No login required - just enter Student ID and Name</p>
        </div>
        <div class="modal-footer">
            <button class="btn-primary" id="closeModalBtn">Close</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var searchTimer = null;
        var pendingDeleteId = null;
        var isEditing = false;
        var antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        function filterCourses() {
            var searchTerm = document.getElementById('searchInput').value.toLowerCase();
            var cards = document.querySelectorAll('.course-card');
            for (var i = 0; i < cards.length; i++) {
                var card = cards[i];
                var name = card.getAttribute('data-name');
                var code = card.getAttribute('data-code');
                if (name && code) {
                    var show = name.includes(searchTerm) || code.includes(searchTerm);
                    card.style.display = show ? '' : 'none';
                }
            }
        }

        function toggleDropdown(btn) {
            var dropdown = btn.nextElementSibling;
            var menus = document.querySelectorAll('.dropdown-menu');
            for (var i = 0; i < menus.length; i++) {
                if (menus[i] !== dropdown) {
                    menus[i].classList.remove('show');
                }
            }
            dropdown.classList.toggle('show');
        }

        document.addEventListener('click', function(e) {
            if (!e.target.classList.contains('dropdown-btn')) {
                var menus = document.querySelectorAll('.dropdown-menu');
                for (var i = 0; i < menus.length; i++) {
                    menus[i].classList.remove('show');
                }
            }
        });

        function manageCourse(id) {
            window.location.href = '/Admin/CourseManage/' + id;
        }

        function viewCourseDetails(id) {
            window.location.href = '/Admin/CourseDetails/' + id;
        }

        function openAddModal() {
            isEditing = false;
            document.getElementById('modalTitle').textContent = 'Add Course';
            clearForm();
            openModal('courseModal');
        }

        function editCourse(id, code, name, units, section, schedule, teacherId) {
            isEditing = true;
            document.getElementById('modalTitle').textContent = 'Edit Course';
            document.getElementById('dbId').value = id;
            document.getElementById('courseCode').value = code;
            document.getElementById('courseName').value = name;
            document.getElementById('units').value = units;
            document.getElementById('section').value = section;
            document.getElementById('schedule').value = schedule;
            document.getElementById('teacherId').value = teacherId;
            openModal('courseModal');
        }

        function viewCourse(id, name, code, section, schedule, units, teacher) {
            var viewBody = document.getElementById('viewBody');
            if (viewBody) {
                viewBody.innerHTML = '<div class="profile-view">' +
                    '<div class="profile-avatar" style="font-size:12px;letter-spacing:.05em;">' + escapeHtml(code) + '</div>' +
                    '<h3 class="profile-name">' + escapeHtml(name) + '</h3>' +
                    '<div class="profile-details">' +
                    '<div class="detail-row"><span class="detail-label">Section</span><span>' + escapeHtml(section) + '</span></div>' +
                    '<div class="detail-row"><span class="detail-label">Schedule</span><span>' + escapeHtml(schedule) + '</span></div>' +
                    '<div class="detail-row"><span class="detail-label">Units</span><span>' + units + ' units</span></div>' +
                    '<div class="detail-row"><span class="detail-label">Teacher</span><span>' + escapeHtml(teacher) + '</span></div>' +
                    '</div>' +
                    '</div>';
            }
            openModal('viewModal');
        }

        function confirmDelete(id, name) {
            pendingDeleteId = id;
            var deleteName = document.getElementById('deleteName');
            if (deleteName) {
                deleteName.textContent = name;
            }
            openModal('deleteModal');
        }

        async function submitCourse() {
            var code = document.getElementById('courseCode').value.trim();
            var name = document.getElementById('courseName').value.trim();
            var section = document.getElementById('section').value.trim();
            var schedule = document.getElementById('schedule').value.trim();
            var teacher = document.getElementById('teacherId').value;
            var units = document.getElementById('units').value;

            if (!code || !name || !section || !schedule || !teacher) {
                if (typeof Toast !== 'undefined') Toast.warning('Please fill in all required fields.');
                return;
            }

            var btn = document.getElementById('saveBtn');
            btn.disabled = true;
            btn.textContent = 'Saving...';

            var url = isEditing ? '/Admin/UpdateCourse' : '/Admin/AddCourse';
            var payload = new URLSearchParams({
                __RequestVerificationToken: antiForgeryToken,
                id: document.getElementById('dbId').value,
                courseCode: code,
                courseName: name,
                units: units,
                section: section,
                schedule: schedule,
                teacherId: teacher
            });

            try {
                var res = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
                    body: payload
                });
                var data = await res.json();
                if (data.success) {
                    if (typeof Toast !== 'undefined') Toast.success(data.message);
                    closeModal('courseModal');
                    location.reload();
                } else {
                    if (typeof Toast !== 'undefined') Toast.error(data.message);
                }
            } catch (error) {
                console.error('Error:', error);
                if (typeof Toast !== 'undefined') Toast.error('An unexpected error occurred.');
            } finally {
                btn.disabled = false;
                btn.textContent = 'Save Course';
            }
        }

        async function submitDelete() {
            var btn = document.getElementById('confirmDeleteBtn');
            btn.disabled = true;
            btn.textContent = 'Deleting...';

            var payload = new URLSearchParams({
                __RequestVerificationToken: antiForgeryToken,
                id: pendingDeleteId
            });

            try {
                var res = await fetch('/Admin/DeleteCourse', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
                    body: payload
                });
                var data = await res.json();
                if (data.success) {
                    if (typeof Toast !== 'undefined') Toast.success(data.message);
                    closeModal('deleteModal');
                    location.reload();
                } else {
                    if (typeof Toast !== 'undefined') Toast.error(data.message);
                }
            } catch (error) {
                console.error('Error:', error);
                if (typeof Toast !== 'undefined') Toast.error('An unexpected error occurred.');
            } finally {
                btn.disabled = false;
                btn.textContent = 'Yes, Delete';
            }
        }

        async function generateAttendanceQR(courseId, courseName) {
            openModal('qrModal');

            var qrContainer = document.getElementById('qrImageContainer');
            if (qrContainer) {
                qrContainer.innerHTML = '<div class="spinner-ring"></div>';
            }

            var courseNameElement = document.getElementById('qrCourseName');
            if (courseNameElement) {
                courseNameElement.textContent = courseName;
            }

            var today = new Date().toISOString().slice(0, 10);
            var formData = new URLSearchParams();
            formData.append('__RequestVerificationToken', antiForgeryToken);
            formData.append('courseId', courseId);
            formData.append('date', today);

            try {
                var response = await fetch('/Admin/GenerateAttendanceQR', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: formData
                });
                var data = await response.json();

                if (data.success && data.qrCode) {
                    if (qrContainer) {
                        qrContainer.innerHTML = '<img src="data:image/png;base64,' + data.qrCode + '" style="width: 200px; height: 200px; margin: 0 auto; display: block;" />';
                    }
                } else {
                    if (qrContainer) {
                        qrContainer.innerHTML = '<p style="color: #ef4444; text-align: center;">' + (data.message || 'Failed to generate QR code') + '</p>';
                    }
                    if (typeof Toast !== 'undefined') Toast.error(data.message || 'Failed to generate QR code');
                }
            } catch (error) {
                console.error('Error generating QR:', error);
                if (qrContainer) {
                    qrContainer.innerHTML = '<p style="color: #ef4444; text-align: center;">Error generating QR code</p>';
                }
                if (typeof Toast !== 'undefined') Toast.error('Error generating QR code');
            }
        }

        function clearForm() {
            var ids = ['dbId', 'courseCode', 'courseName', 'section', 'schedule'];
            for (var i = 0; i < ids.length; i++) {
                var el = document.getElementById(ids[i]);
                if (el) el.value = '';
            }
            var unitsEl = document.getElementById('units');
            if (unitsEl) unitsEl.value = '3';
            var teacherEl = document.getElementById('teacherId');
            if (teacherEl) teacherEl.value = '';
        }

        function openModal(id) {
            var modal = document.getElementById(id);
            if (modal) modal.classList.add('active');
        }

        function closeModal(id) {
            var modal = document.getElementById(id);
            if (modal) modal.classList.remove('active');
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/[&<>]/g, function(m) {
                if (m === '&') return '&amp;';
                if (m === '<') return '&lt;';
                if (m === '>') return '&gt;';
                return m;
            });
        }

        var overlays = document.querySelectorAll('.modal-overlay');
        for (var i = 0; i < overlays.length; i++) {
            overlays[i].addEventListener('click', function(e) {
                if (e.target === this) {
                    this.classList.remove('active');
                }
            });
        }

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                var activeModals = document.querySelectorAll('.modal-overlay.active');
                for (var i = 0; i < activeModals.length; i++) {
                    activeModals[i].classList.remove('active');
                }
            }
        });
    </script>
}