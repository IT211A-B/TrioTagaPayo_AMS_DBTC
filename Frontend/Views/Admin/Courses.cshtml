@{
    ViewData["Title"] = "Courses";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Courses</h1>
        <p class="page-subtitle">Manage all courses offered this semester</p>
    </div>
    <button class="btn-primary" onclick="openAddModal()">+ Add Course</button>
</div>

<!-- Search and Filter Bar -->
<div class="filter-bar">
    <div class="search-box">
        <span class="search-icon">&#128269;</span>
        <input type="text" id="searchInput" placeholder="Search course name or code..." onkeyup="filterTable()" />
    </div>
    <select id="filterStatus" onchange="filterTable()">
        <option value="">All Status</option>
        <option value="Active">Active</option>
        <option value="Inactive">Inactive</option>
    </select>
</div>

<!-- Courses Table -->
<div class="card">
    <table class="data-table" id="coursesTable">
        <thead>
            <tr>
                <th>#</th>
                <th>Course Code</th>
                <th>Course Name</th>
                <th>Assigned Teacher</th>
                <th>Students</th>
                <th>Schedule</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>1</td>
                <td><span class="course-code">CS101</span></td>
                <td>Introduction to Computing</td>
                <td>Mr. Santos</td>
                <td>32</td>
                <td>MWF 7:30 AM</td>
                <td><span class="badge badge-active">Active</span></td>
                <td>
                    <button class="btn-icon" title="Edit" onclick="openEditModal('CS101', 'Introduction to Computing', 'Mr. Santos', 'MWF 7:30 AM', 'Active')">&#9998;</button>
                    <button class="btn-icon btn-danger" title="Delete" onclick="confirmDelete('Introduction to Computing')">&#128465;</button>
                </td>
            </tr>
            <tr>
                <td>2</td>
                <td><span class="course-code">CS102</span></td>
                <td>Programming 1</td>
                <td>Ms. Reyes</td>
                <td>28</td>
                <td>TTH 9:00 AM</td>
                <td><span class="badge badge-active">Active</span></td>
                <td>
                    <button class="btn-icon" title="Edit" onclick="openEditModal('CS102', 'Programming 1', 'Ms. Reyes', 'TTH 9:00 AM', 'Active')">&#9998;</button>
                    <button class="btn-icon btn-danger" title="Delete" onclick="confirmDelete('Programming 1')">&#128465;</button>
                </td>
            </tr>
            <tr>
                <td>3</td>
                <td><span class="course-code">MATH01</span></td>
                <td>College Algebra</td>
                <td>Mr. Cruz</td>
                <td>40</td>
                <td>MWF 10:30 AM</td>
                <td><span class="badge badge-active">Active</span></td>
                <td>
                    <button class="btn-icon" title="Edit" onclick="openEditModal('MATH01', 'College Algebra', 'Mr. Cruz', 'MWF 10:30 AM', 'Active')">&#9998;</button>
                    <button class="btn-icon btn-danger" title="Delete" onclick="confirmDelete('College Algebra')">&#128465;</button>
                </td>
            </tr>
            <tr>
                <td>4</td>
                <td><span class="course-code">ENG01</span></td>
                <td>English Communication</td>
                <td>Ms. Lim</td>
                <td>35</td>
                <td>TTH 1:00 PM</td>
                <td><span class="badge badge-inactive">Inactive</span></td>
                <td>
                    <button class="btn-icon" title="Edit" onclick="openEditModal('ENG01', 'English Communication', 'Ms. Lim', 'TTH 1:00 PM', 'Inactive')">&#9998;</button>
                    <button class="btn-icon btn-danger" title="Delete" onclick="confirmDelete('English Communication')">&#128465;</button>
                </td>
            </tr>
            <tr>
                <td>5</td>
                <td><span class="course-code">PE001</span></td>
                <td>Physical Education 1</td>
                <td>Mr. Dela Cruz</td>
                <td>45</td>
                <td>SAT 7:00 AM</td>
                <td><span class="badge badge-active">Active</span></td>
                <td>
                    <button class="btn-icon" title="Edit" onclick="openEditModal('PE001', 'Physical Education 1', 'Mr. Dela Cruz', 'SAT 7:00 AM', 'Active')">&#9998;</button>
                    <button class="btn-icon btn-danger" title="Delete" onclick="confirmDelete('Physical Education 1')">&#128465;</button>
                </td>
            </tr>
        </tbody>
    </table>
</div>

<!-- Add / Edit Modal -->
<div class="modal-overlay" id="courseModal">
    <div class="modal-box">
        <div class="modal-header">
            <h2 id="modalTitle">Add Course</h2>
            <button class="modal-close" onclick="closeModal()">&#10005;</button>
        </div>
        <div class="modal-body">
            <div class="form-group">
                <label>Course Code</label>
                <input type="text" id="fldCode" placeholder="e.g. CS101" />
            </div>
            <div class="form-group">
                <label>Course Name</label>
                <input type="text" id="fldName" placeholder="e.g. Introduction to Computing" />
            </div>
            <div class="form-group">
                <label>Assigned Teacher</label>
                <select id="fldTeacher">
                    <option value="">-- Select Teacher --</option>
                    <option>Mr. Santos</option>
                    <option>Ms. Reyes</option>
                    <option>Mr. Cruz</option>
                    <option>Ms. Lim</option>
                    <option>Mr. Dela Cruz</option>
                </select>
            </div>
            <div class="form-group">
                <label>Schedule</label>
                <input type="text" id="fldSchedule" placeholder="e.g. MWF 7:30 AM" />
            </div>
            <div class="form-group">
                <label>Status</label>
                <select id="fldStatus">
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                </select>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn-secondary" onclick="closeModal()">Cancel</button>
            <button class="btn-primary" onclick="saveModal()">Save Course</button>
        </div>
    </div>
</div>

<!-- Delete Confirm Modal -->
<div class="modal-overlay" id="deleteModal">
    <div class="modal-box modal-small">
        <div class="modal-header">
            <h2>Delete Course</h2>
            <button class="modal-close" onclick="closeDeleteModal()">&#10005;</button>
        </div>
        <div class="modal-body">
            <p>Are you sure you want to delete <strong id="deleteName"></strong>? This cannot be undone.</p>
        </div>
        <div class="modal-footer">
            <button class="btn-secondary" onclick="closeDeleteModal()">Cancel</button>
            <button class="btn-danger-solid" onclick="closeDeleteModal()">Yes, Delete</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // --- Search & Filter ---
        function filterTable() {
            var search = document.getElementById("searchInput").value.toLowerCase();
            var status = document.getElementById("filterStatus").value.toLowerCase();
            var rows = document.querySelectorAll("#coursesTable tbody tr");

            rows.forEach(function (row) {
                var text = row.innerText.toLowerCase();
                var rowStatus = row.querySelector(".badge") ? row.querySelector(".badge").innerText.toLowerCase() : "";
                var matchSearch = text.includes(search);
                var matchStatus = status === "" || rowStatus === status;
                row.style.display = matchSearch && matchStatus ? "" : "none";
            });
        }

        // --- Add Modal ---
        function openAddModal() {
            document.getElementById("modalTitle").innerText = "Add Course";
            document.getElementById("fldCode").value = "";
            document.getElementById("fldName").value = "";
            document.getElementById("fldTeacher").value = "";
            document.getElementById("fldSchedule").value = "";
            document.getElementById("fldStatus").value = "Active";
            document.getElementById("courseModal").classList.add("active");
        }

        // --- Edit Modal ---
        function openEditModal(code, name, teacher, schedule, status) {
            document.getElementById("modalTitle").innerText = "Edit Course";
            document.getElementById("fldCode").value = code;
            document.getElementById("fldName").value = name;
            document.getElementById("fldTeacher").value = teacher;
            document.getElementById("fldSchedule").value = schedule;
            document.getElementById("fldStatus").value = status;
            document.getElementById("courseModal").classList.add("active");
        }

        function closeModal() {
            document.getElementById("courseModal").classList.remove("active");
        }

        function saveModal() {
            // In a real project, this would post to the controller
            alert("Course saved! (Connect to your controller here)");
            closeModal();
        }

        // --- Delete Modal ---
        function confirmDelete(name) {
            document.getElementById("deleteName").innerText = name;
            document.getElementById("deleteModal").classList.add("active");
        }

        function closeDeleteModal() {
            document.getElementById("deleteModal").classList.remove("active");
        }

        // Close modal when clicking outside
        document.querySelectorAll(".modal-overlay").forEach(function (overlay) {
            overlay.addEventListener("click", function (e) {
                if (e.target === overlay) {
                    overlay.classList.remove("active");
                }
            });
        });
    </script>
}
