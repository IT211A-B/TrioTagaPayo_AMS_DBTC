@model AMS.ViewModels.CoursesPageViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Courses";
    ViewData["PageTitle"] = "Courses";
}

<div class="page-header">
    <div>
        <h2>Courses</h2>
        <p>Manage all courses offered this semester</p>
    </div>
    <button class="btn-primary" onclick="openAddModal()">+ Add Course</button>
</div>

<div class="summary-bar">
    <div class="summary-pill"><span class="pill-dot dot-blue"></span>Total: <strong>@Model.Courses.Count</strong></div>
</div>

<div class="filter-bar">
    <input type="text" id="searchInput" class="search-input"
           placeholder="Search by course code or name..."
           value="@Model.Search" oninput="handleSearch()" />
</div>

<div class="table-wrapper">
    <table class="data-table">
        <thead>
            <tr>
                <th>Course</th>
                <th class="hide-sm">Code</th>
                <th class="hide-sm">Section</th>
                <th class="hide-md">Schedule</th>
                <th class="hide-sm">Teacher</th>
                <th>Units</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="coursesBody">
            @if (Model.Courses.Any())
            {
                @foreach (var c in Model.Courses)
                {
                    <tr class="table-row fade-in-row" id="row-@c.DbId">
                        <td><p class="cell-name">@c.CourseName</p></td>
                        <td class="hide-sm"><span class="course-code-badge">@c.CourseCode</span></td>
                        <td class="hide-sm">@c.Section</td>
                        <td class="hide-md"><p class="cell-sub">@c.Schedule</p></td>
                        <td class="hide-sm">@c.TeacherName</td>
                        <td>@c.Units units</td>
                        <td>
                            <div class="action-btns">
                                <button class="btn-sm btn-view"
                                        onclick="viewCourse(@c.DbId,'@Html.Raw(c.CourseName)','@c.CourseCode','@c.Section','@Html.Raw(c.Schedule)','@c.Units','@Html.Raw(c.TeacherName)')">
                                    View
                                </button>
                                <button class="btn-sm btn-edit"
                                        onclick="editCourse(@c.DbId,'@c.CourseCode','@Html.Raw(c.CourseName)','@c.Units','@c.Section','@Html.Raw(c.Schedule)','@c.TeacherId')">
                                    Edit
                                </button>
                                <button class="btn-sm btn-delete"
                                        onclick="confirmDelete(@c.DbId,'@Html.Raw(c.CourseName)')">
                                    Delete
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7">
                        @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel
                        {
                            Icon = "◧", Title = "No courses found",
                                        Message = "Try a different search or add a new course."
                                        })
                </td>
            </tr>
                        }
        </tbody>
    </table>
</div>

<!-- ADD / EDIT MODAL -->
<div class="modal-overlay" id="courseModal">
    <div class="modal-card">
        <div class="modal-header">
            <h3 id="modalTitle">Add Course</h3>
            <button class="modal-close" onclick="closeModal('courseModal')">×</button>
        </div>
        <div class="modal-body">
            @Html.AntiForgeryToken()
            <input type="hidden" id="dbId" />
            <div class="form-row">
                <div class="form-group">
                    <label>Course Code <span class="req">*</span></label>
                    <input type="text" id="courseCode" class="form-input" placeholder="e.g. CS101" required />
                </div>
                <div class="form-group">
                    <label>Units <span class="req">*</span></label>
                    <input type="number" id="units" class="form-input" value="3" min="1" max="10" required />
                </div>
            </div>
            <div class="form-group">
                <label>Course Name <span class="req">*</span></label>
                <input type="text" id="courseName" class="form-input" placeholder="e.g. Introduction to Computing" required />
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Section <span class="req">*</span></label>
                    <input type="text" id="section" class="form-input" placeholder="e.g. 3TagaPayu" required />
                </div>
                <div class="form-group">
                    <label>Schedule <span class="req">*</span></label>
                    <input type="text" id="schedule" class="form-input" placeholder="e.g. Mon/Wed 8:00-10:00 AM" required />
                </div>
            </div>
            <div class="form-group">
                <label>Teacher <span class="req">*</span></label>
                <select id="teacherId" class="form-input" required>
                    <option value="">— Select Teacher —</option>
                    @foreach (var t in Model.Teachers)
                    {
                        <option value="@t.DbId">@t.FullName (@t.TeacherNo)</option>
                    }
                </select>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn-secondary" onclick="closeModal('courseModal')">Cancel</button>
            <button class="btn-primary" id="saveBtn" onclick="submitCourse()">Save Course</button>
        </div>
    </div>
</div>

<!-- VIEW MODAL -->
<div class="modal-overlay" id="viewModal">
    <div class="modal-card">
        <div class="modal-header">
            <h3>Course Details</h3>
            <button class="modal-close" onclick="closeModal('viewModal')">×</button>
        </div>
        <div class="modal-body" id="viewBody"></div>
        <div class="modal-footer">
            <button class="btn-primary" onclick="closeModal('viewModal')">Close</button>
        </div>
    </div>
</div>

<!-- DELETE MODAL -->
<div class="modal-overlay" id="deleteModal">
    <div class="modal-card modal-sm">
        <div class="modal-header">
            <h3>Delete Course</h3>
            <button class="modal-close" onclick="closeModal('deleteModal')">×</button>
        </div>
        <div class="modal-body">
            <p>Are you sure you want to delete <strong id="deleteName"></strong>? This cannot be undone.</p>
        </div>
        <div class="modal-footer">
            <button class="btn-secondary" onclick="closeModal('deleteModal')">Cancel</button>
            <button class="btn-danger" id="confirmDeleteBtn" onclick="submitDelete()">Yes, Delete</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let searchTimer = null, pendingDeleteId = null, isEditing = false;
        const antiForgery = document.querySelector('input[name="__RequestVerificationToken"]').value;

        // Client-side search (courses are fully loaded — no lazy load needed)
        function handleSearch() {
            clearTimeout(searchTimer);
            searchTimer = setTimeout(() => {
                const q = document.getElementById('searchInput').value.toLowerCase();
                document.querySelectorAll('#coursesBody tr.table-row').forEach(row => {
                    const text = row.textContent.toLowerCase();
                    row.style.display = text.includes(q) ? '' : 'none';
                });
            }, 200);
        }

        function openAddModal() {
            isEditing = false;
            document.getElementById('modalTitle').textContent = 'Add Course';
            clearForm();
            openModal('courseModal');
        }

        function editCourse(id, code, name, units, section, schedule, teacherId) {
            isEditing = true;
            document.getElementById('modalTitle').textContent = 'Edit Course';
            document.getElementById('dbId').value        = id;
            document.getElementById('courseCode').value  = code;
            document.getElementById('courseName').value  = name;
            document.getElementById('units').value       = units;
            document.getElementById('section').value     = section;
            document.getElementById('schedule').value    = schedule;
            document.getElementById('teacherId').value   = teacherId;
            openModal('courseModal');
        }

        function viewCourse(id, name, code, section, schedule, units, teacher) {
            document.getElementById('viewBody').innerHTML = `
                <div class="profile-view">
                    <div class="profile-avatar" style="border-radius:10px;font-size:13px;">${code}</div>
                    <h3 class="profile-name">${name}</h3>
                    <div class="profile-details">
                        <div class="detail-row"><span class="detail-label">Section</span><span>${section}</span></div>
                        <div class="detail-row"><span class="detail-label">Schedule</span><span>${schedule}</span></div>
                        <div class="detail-row"><span class="detail-label">Units</span><span>${units} units</span></div>
                        <div class="detail-row"><span class="detail-label">Teacher</span><span>${teacher}</span></div>
                    </div>
                </div>`;
            openModal('viewModal');
        }

        function confirmDelete(id, name) {
            pendingDeleteId = id;
            document.getElementById('deleteName').textContent = name;
            openModal('deleteModal');
        }

        async function submitCourse() {
            const code     = document.getElementById('courseCode').value.trim();
            const name     = document.getElementById('courseName').value.trim();
            const section  = document.getElementById('section').value.trim();
            const schedule = document.getElementById('schedule').value.trim();
            const teacher  = document.getElementById('teacherId').value;
            const units    = document.getElementById('units').value;

            if (!code || !name || !section || !schedule || !teacher) {
                Toast.warning('Please fill in all required fields.');
                return;
            }

            const btn = document.getElementById('saveBtn');
            btn.disabled = true; btn.textContent = 'Saving...';

            const url     = isEditing ? '/Admin/UpdateCourse' : '/Admin/AddCourse';
            const payload = new URLSearchParams({
                __RequestVerificationToken: antiForgery,
                id: document.getElementById('dbId').value,
                courseCode: code, courseName: name, units, section, schedule, teacherId: teacher
            });

            try {
                const res  = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
                    body: payload
                });
                const data = await res.json();
                if (data.success) {
                    Toast.success(data.message);
                    closeModal('courseModal');
                    // Reload page to reflect new/updated course in table
                    location.reload();
                } else {
                    Toast.error(data.message);
                }
            } catch { Toast.error('An unexpected error occurred.'); }
            finally  { btn.disabled = false; btn.textContent = 'Save Course'; }
        }

        async function submitDelete() {
            const btn = document.getElementById('confirmDeleteBtn');
            btn.disabled = true; btn.textContent = 'Deleting...';

            const payload = new URLSearchParams({
                __RequestVerificationToken: antiForgery,
                id: pendingDeleteId
            });

            try {
                const res  = await fetch('/Admin/DeleteCourse', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
                    body: payload
                });
                const data = await res.json();
                if (data.success) {
                    Toast.success(data.message);
                    closeModal('deleteModal');
                    const row = document.getElementById(`row-${pendingDeleteId}`);
                    if (row) { row.style.transition = 'opacity 0.3s'; row.style.opacity = '0'; setTimeout(() => row.remove(), 300); }
                } else {
                    Toast.error(data.message);
                }
            } catch { Toast.error('An unexpected error occurred.'); }
            finally  { btn.disabled = false; btn.textContent = 'Yes, Delete'; }
        }

        function clearForm() {
            ['dbId','courseCode','courseName','section','schedule'].forEach(id => document.getElementById(id).value = '');
            document.getElementById('units').value    = '3';
            document.getElementById('teacherId').value = '';
        }

        function openModal(id)  { document.getElementById(id).classList.add('active'); }
        function closeModal(id) { document.getElementById(id).classList.remove('active'); }
        document.querySelectorAll('.modal-overlay').forEach(o =>
            o.addEventListener('click', e => { if (e.target === o) o.classList.remove('active'); }));
        document.addEventListener('keydown', e => {
            if (e.key === 'Escape') document.querySelectorAll('.modal-overlay.active').forEach(m => m.classList.remove('active'));
        });
    </script>
}
