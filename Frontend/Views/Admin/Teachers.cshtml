@{
    ViewData["Title"] = "Teachers";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <div>
        <h2>Teachers</h2>
        <p>Manage all registered faculty members</p>
    </div>
    <div class="page-header-actions">
        <button class="btn-primary" onclick="openAddModal()">+ Add Teacher</button>
    </div>
</div>

<!-- Summary pills -->
<div class="summary-bar">
    <div class="summary-pill">
        <span class="summary-dot dot-blue"></span>
        <span>3 Total Teachers</span>
    </div>
    <div class="summary-pill">
        <span class="summary-dot dot-green"></span>
        <span>2 Active</span>
    </div>
    <div class="summary-pill">
        <span class="summary-dot dot-red"></span>
        <span>1 Inactive</span>
    </div>
</div>

<!-- Search and Filter Bar -->
<div class="table-toolbar" style="background:#fff; border:1px solid var(--border); border-radius:var(--radius-lg); margin-bottom:16px;">
    <input type="text" class="search-input" id="searchInput" placeholder="Search by name or ID..." onkeyup="filterTable()" />
    <select class="filter-select" id="deptFilter" onchange="filterTable()">
        <option value="">All Departments</option>
        <option value="BSIT">BSIT</option>
        <option value="BSCS">BSCS</option>
        <option value="BSED">BSED</option>
        <option value="BSBA">BSBA</option>
        <option value="BSHRM">BSHRM</option>
    </select>
    <select class="filter-select" id="statusFilter" onchange="filterTable()">
        <option value="">All Status</option>
        <option value="Active">Active</option>
        <option value="Inactive">Inactive</option>
    </select>
</div>

<!-- Teachers Table -->
<div class="table-card">
    <table class="data-table" id="teachersTable">
        <thead>
            <tr>
                <th>Teacher ID</th>
                <th>Name</th>
                <th>Department</th>
                <th>Subjects</th>
                <th>Contact</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>

            <!-- 1. James Maano -->
            <tr>
                <td class="table-id">TCH-001</td>
                <td>
                    <div class="student-name-cell">
                        <div class="student-avatar" style="background: linear-gradient(135deg, #1A56C4, #0F3E9E);">JM</div>
                        <div>
                            <div class="student-fullname">Mr. James Maano</div>
                            <div class="student-email">j.maano@@school.edu</div>
                        </div>
                    </div>
                </td>
                <td><span class="dept-badge bsit">BSIT</span></td>
                <td>4 Subjects</td>
                <td>09171234501</td>
                <td><span class="badge badge-active">Active</span></td>
                <td>
                    <div class="table-actions">
                        <button class="btn-sm btn-view" onclick="openViewModal('TCH-001','Mr. James Maano','j.maano@@school.edu','BSIT','4 Subjects','09171234501','Active','JM')">View</button>
                        <button class="btn-sm btn-edit" onclick="openEditModal('TCH-001','James','Maano','j.maano@@school.edu','BSIT','09171234501','Active')">Edit</button>
                        <button class="btn-sm btn-del" onclick="confirmDelete('TCH-001','Mr. James Maano')">Delete</button>
                    </div>
                </td>
            </tr>

            <!-- 2. Armanes Artajo -->
            <tr>
                <td class="table-id">TCH-002</td>
                <td>
                    <div class="student-name-cell">
                        <div class="student-avatar" style="background: linear-gradient(135deg, #0F7A4F, #095c3a);">AA</div>
                        <div>
                            <div class="student-fullname">Mr. Armanes Artajo</div>
                            <div class="student-email">a.artajo@@school.edu</div>
                        </div>
                    </div>
                </td>
                <td><span class="dept-badge bscs">BSCS</span></td>
                <td>3 Subjects</td>
                <td>09281234502</td>
                <td><span class="badge badge-active">Active</span></td>
                <td>
                    <div class="table-actions">
                        <button class="btn-sm btn-view" onclick="openViewModal('TCH-002','Mr. Armanes Artajo','a.artajo@@school.edu','BSCS','3 Subjects','09281234502','Active','AA')">View</button>
                        <button class="btn-sm btn-edit" onclick="openEditModal('TCH-002','Armanes','Artajo','a.artajo@@school.edu','BSCS','09281234502','Active')">Edit</button>
                        <button class="btn-sm btn-del" onclick="confirmDelete('TCH-002','Mr. Armanes Artajo')">Delete</button>
                    </div>
                </td>
            </tr>

            <!-- 3. Rimark Rafel Moreno -->
            <tr>
                <td class="table-id">TCH-003</td>
                <td>
                    <div class="student-name-cell">
                        <div class="student-avatar" style="background: linear-gradient(135deg, #B06000, #8a4900);">RM</div>
                        <div>
                            <div class="student-fullname">Mr. Rimark Rafel Moreno</div>
                            <div class="student-email">r.moreno@@school.edu</div>
                        </div>
                    </div>
                </td>
                <td><span class="dept-badge bsed">BSED</span></td>
                <td>2 Subjects</td>
                <td>09391234503</td>
                <td><span class="badge badge-inactive">Inactive</span></td>
                <td>
                    <div class="table-actions">
                        <button class="btn-sm btn-view" onclick="openViewModal('TCH-003','Mr. Rimark Rafel Moreno','r.moreno@@school.edu','BSED','2 Subjects','09391234503','Inactive','RM')">View</button>
                        <button class="btn-sm btn-edit" onclick="openEditModal('TCH-003','Rimark','Moreno','r.moreno@@school.edu','BSED','09391234503','Inactive')">Edit</button>
                        <button class="btn-sm btn-del" onclick="confirmDelete('TCH-003','Mr. Rimark Rafel Moreno')">Delete</button>
                    </div>
                </td>
            </tr>

        </tbody>
    </table>
</div>


<!-- ===================== ADD / EDIT MODAL ===================== -->
<div class="modal-overlay" id="teacherModal">
    <div class="modal-box">
        <div class="modal-header">
            <h2 id="modalTitle">Add Teacher</h2>
            <button class="modal-close" onclick="closeModal()">&#10005;</button>
        </div>
        <div class="modal-body">
            <div class="form-group">
                <label>First Name</label>
                <input type="text" id="fldFirst" placeholder="e.g. James" />
            </div>
            <div class="form-group">
                <label>Last Name</label>
                <input type="text" id="fldLast" placeholder="e.g. Maano" />
            </div>
            <div class="form-group">
                <label>Email Address</label>
                <input type="email" id="fldEmail" placeholder="e.g. j.maano@@school.edu" />
            </div>
            <div class="form-group">
                <label>Department</label>
                <select id="fldDept">
                    <option value="">-- Select Department --</option>
                    <option value="BSIT">BSIT</option>
                    <option value="BSCS">BSCS</option>
                    <option value="BSED">BSED</option>
                    <option value="BSBA">BSBA</option>
                    <option value="BSHRM">BSHRM</option>
                </select>
            </div>
            <div class="form-group">
                <label>Contact Number</label>
                <input type="text" id="fldContact" placeholder="e.g. 09171234501" />
            </div>
            <div class="form-group">
                <label>Status</label>
                <select id="fldStatus">
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                </select>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn-secondary" onclick="closeModal()">Cancel</button>
            <button class="btn-primary" onclick="saveModal()">Save Teacher</button>
        </div>
    </div>
</div>


<!-- ===================== VIEW MODAL ===================== -->
<div class="modal-overlay" id="viewModal">
    <div class="modal-box">
        <div class="modal-header">
            <h2>Teacher Profile</h2>
            <button class="modal-close" onclick="closeViewModal()">&#10005;</button>
        </div>
        <div class="modal-body">
            <div class="view-student-top">
                <div class="view-avatar" id="viewAvatar">JM</div>
                <div>
                    <div class="view-name" id="viewName">Mr. James Maano</div>
                    <div class="view-id" id="viewTchId">TCH-001</div>
                </div>
            </div>
            <div class="view-details">
                <div class="view-row">
                    <span class="view-label">Email</span>
                    <span class="view-value" id="viewEmail">-</span>
                </div>
                <div class="view-row">
                    <span class="view-label">Department</span>
                    <span class="view-value" id="viewDept">-</span>
                </div>
                <div class="view-row">
                    <span class="view-label">Subjects Handled</span>
                    <span class="view-value" id="viewSubjects">-</span>
                </div>
                <div class="view-row">
                    <span class="view-label">Contact</span>
                    <span class="view-value" id="viewContact">-</span>
                </div>
                <div class="view-row">
                    <span class="view-label">Status</span>
                    <span class="view-value" id="viewStatus">-</span>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn-secondary" onclick="closeViewModal()">Close</button>
        </div>
    </div>
</div>


<!-- ===================== DELETE MODAL ===================== -->
<div class="modal-overlay" id="deleteModal">
    <div class="modal-box modal-small">
        <div class="modal-header">
            <h2>Remove Teacher</h2>
            <button class="modal-close" onclick="closeDeleteModal()">&#10005;</button>
        </div>
        <div class="modal-body">
            <p>Are you sure you want to remove <strong id="deleteName"></strong>? This action cannot be undone.</p>
        </div>
        <div class="modal-footer">
            <button class="btn-secondary" onclick="closeDeleteModal()">Cancel</button>
            <button class="btn-danger-solid" onclick="closeDeleteModal()">Yes, Remove</button>
        </div>
    </div>
</div>


@section Scripts {
    <script>

        // ---- Search & Filter ----
        function filterTable() {
            var search = document.getElementById("searchInput").value.toLowerCase();
            var dept   = document.getElementById("deptFilter").value.toLowerCase();
            var status = document.getElementById("statusFilter").value.toLowerCase();
            var rows   = document.querySelectorAll("#teachersTable tbody tr");

            rows.forEach(function (row) {
                var id       = row.cells[0].innerText.toLowerCase();
                var name     = row.cells[1].innerText.toLowerCase();
                var deptText = row.cells[2].innerText.toLowerCase();
                var statText = row.cells[5].innerText.toLowerCase();

                var okSearch = id.includes(search) || name.includes(search);
                var okDept   = dept === "" || deptText.includes(dept);
                var okStatus = status === "" || statText.includes(status);

                row.style.display = (okSearch && okDept && okStatus) ? "" : "none";
            });
        }

        // ---- Add Modal ----
        function openAddModal() {
            document.getElementById("modalTitle").innerText = "Add Teacher";
            document.getElementById("fldFirst").value   = "";
            document.getElementById("fldLast").value    = "";
            document.getElementById("fldEmail").value   = "";
            document.getElementById("fldDept").value    = "";
            document.getElementById("fldContact").value = "";
            document.getElementById("fldStatus").value  = "Active";
            document.getElementById("teacherModal").classList.add("active");
        }

        // ---- Edit Modal ----
        function openEditModal(id, first, last, email, dept, contact, status) {
            document.getElementById("modalTitle").innerText = "Edit Teacher";
            document.getElementById("fldFirst").value   = first;
            document.getElementById("fldLast").value    = last;
            document.getElementById("fldEmail").value   = email;
            document.getElementById("fldDept").value    = dept;
            document.getElementById("fldContact").value = contact;
            document.getElementById("fldStatus").value  = status;
            document.getElementById("teacherModal").classList.add("active");
        }

        function closeModal() {
            document.getElementById("teacherModal").classList.remove("active");
        }

        function saveModal() {
            alert("Teacher saved! (Connect to your controller here)");
            closeModal();
        }

        // ---- View Modal ----
        function openViewModal(id, name, email, dept, subjects, contact, status, initials) {
            document.getElementById("viewAvatar").innerText   = initials;
            document.getElementById("viewName").innerText     = name;
            document.getElementById("viewTchId").innerText    = id;
            document.getElementById("viewEmail").innerText    = email;
            document.getElementById("viewDept").innerText     = dept;
            document.getElementById("viewSubjects").innerText = subjects;
            document.getElementById("viewContact").innerText  = contact;
            document.getElementById("viewStatus").innerText   = status;
            document.getElementById("viewModal").classList.add("active");
        }

        function closeViewModal() {
            document.getElementById("viewModal").classList.remove("active");
        }

        // ---- Delete Modal ----
        function confirmDelete(id, name) {
            document.getElementById("deleteName").innerText = name;
            document.getElementById("deleteModal").classList.add("active");
        }

        function closeDeleteModal() {
            document.getElementById("deleteModal").classList.remove("active");
        }

        // ---- Close modal when clicking outside ----
        document.querySelectorAll(".modal-overlay").forEach(function (overlay) {
            overlay.addEventListener("click", function (e) {
                if (e.target === overlay) {
                    overlay.classList.remove("active");
                }
            });
        });

    </script>
}
