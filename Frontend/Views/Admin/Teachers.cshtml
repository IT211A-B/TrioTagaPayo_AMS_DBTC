@model AMS.ViewModels.TeachersPageViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"]     = "Teachers";
    ViewData["PageTitle"] = "Teachers";
}

<div class="page-header">
    <div>
        <h2>Teachers</h2>
        <p>Manage all registered teachers</p>
    </div>
    <button class="btn-primary" onclick="openAddModal()">+ Add Teacher</button>
</div>

<div class="summary-bar">
    <div class="summary-pill"><span class="pill-dot dot-blue"></span>Total: <strong>@Model.TotalCount</strong></div>
    <div class="summary-pill"><span class="pill-dot dot-green"></span>Active: <strong>@Model.ActiveCount</strong></div>
    <div class="summary-pill"><span class="pill-dot dot-red"></span>Inactive: <strong>@Model.InactiveCount</strong></div>
</div>

<div class="filter-bar">
    <input type="text" id="searchInput" class="search-input"
           placeholder="Search by name or teacher no..."
           value="@Model.Search" oninput="handleSearch()" />
    <select id="statusFilter" class="filter-select" onchange="handleSearch()">
        <option value="">All Status</option>
        <option value="Active" selected="@(Model.StatusFilter == "Active")">Active</option>
        <option value="Inactive" selected="@(Model.StatusFilter == "Inactive")">Inactive</option>
    </select>
</div>

<div class="table-wrapper">
    <table class="data-table">
        <thead>
            <tr>
                <th>Teacher</th>
                <th class="hide-sm">Teacher No</th>
                <th class="hide-sm">Courses</th>
                <th class="hide-md">Account</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="teachersBody">
            @if (Model.Teachers.Any())
            {
                @foreach (var t in Model.Teachers)
                {
                    <tr class="table-row fade-in-row" id="row-@t.DbId">
                        <td>
                            <div class="student-cell">
                                <div class="avatar" style="background:@t.AvatarColor">@t.Initials</div>
                                <div>
                                    <p class="cell-name">@t.FullName</p>
                                    <p class="cell-sub">@t.Email</p>
                                </div>
                            </div>
                        </td>
                        <td class="hide-sm"><span class="id-badge">@t.TeacherNo</span></td>
                        <td class="hide-sm">@t.CourseCount course(s)</td>
                        <td class="hide-md">
                            @if (t.HasAccount)
                            {
                                <span class="status-badge badge-active">@t.Username</span>
                            }
                            else
                            {
                                <span class="status-badge badge-inactive">No account</span>
                            }
                        </td>
                        <td>
                            <span class="status-badge @(t.IsActive ? "badge-active" : "badge-inactive")">@t.Status</span>
                        </td>
                        <td>
                            <div class="action-btns">
                                <button class="btn-sm btn-view"
                                    onclick="viewTeacher(@t.DbId,'@Html.Raw(t.FullName)','@t.TeacherNo','@t.Email','@t.CourseCount','@t.Username','@t.IsActive.ToString().ToLower()')">View</button>
                                <button class="btn-sm btn-edit"
                                    onclick="editTeacher(@t.DbId,'@t.TeacherNo','@Html.Raw(t.FirstName)','@Html.Raw(t.LastName)','@t.Email')">Edit</button>
                                <button class="btn-sm btn-delete"
                                    onclick="confirmDelete(@t.DbId,'@Html.Raw(t.FullName)')">Delete</button>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6">
                        @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel
                        {
                            Icon = "◈", Title = "No teachers found",
                            Message = "Try a different search or add a new teacher."
                        })
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div id="loadSentinel"></div>
    <div class="lazy-spinner" id="lazySpinner" style="display:none;"><div class="spinner-ring"></div></div>
</div>

<!-- ADD / EDIT MODAL -->
<div class="modal-overlay" id="teacherModal">
    <div class="modal-card">
        <div class="modal-header">
            <h3 id="modalTitle">Add Teacher</h3>
            <button class="modal-close" onclick="closeModal('teacherModal')">×</button>
        </div>
        <div class="modal-body">
            @Html.AntiForgeryToken()
            <input type="hidden" id="dbId" />
            <div class="form-group">
                <label>Teacher No <span class="req">*</span></label>
                <input type="text" id="teacherNo" class="form-input" placeholder="e.g. TCH-001" required />
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>First Name <span class="req">*</span></label>
                    <input type="text" id="firstName" class="form-input" placeholder="e.g. James" required />
                </div>
                <div class="form-group">
                    <label>Last Name <span class="req">*</span></label>
                    <input type="text" id="lastName" class="form-input" placeholder="e.g. Maano" required />
                </div>
            </div>
            <div class="form-group">
                <label>Email <span class="req">*</span></label>
                <input type="email" id="email" class="form-input" placeholder="teacher@school.edu" required />
            </div>
            <div id="accountFields">
                <div class="form-row">
                    <div class="form-group">
                        <label>Username <span class="req">*</span></label>
                        <input type="text" id="username" class="form-input" placeholder="Login username" />
                    </div>
                    <div class="form-group">
                        <label>Password <span class="req">*</span></label>
                        <input type="password" id="password" class="form-input" placeholder="Min 6 characters" />
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn-secondary" onclick="closeModal('teacherModal')">Cancel</button>
            <button class="btn-primary" id="saveBtn" onclick="submitTeacher()">Save Teacher</button>
        </div>
    </div>
</div>

<!-- VIEW MODAL -->
<div class="modal-overlay" id="viewModal">
    <div class="modal-card">
        <div class="modal-header">
            <h3>Teacher Profile</h3>
            <button class="modal-close" onclick="closeModal('viewModal')">×</button>
        </div>
        <div class="modal-body" id="viewBody"></div>
        <div class="modal-footer">
            <button class="btn-primary" onclick="closeModal('viewModal')">Close</button>
        </div>
    </div>
</div>

<!-- DELETE MODAL -->
<div class="modal-overlay" id="deleteModal">
    <div class="modal-card modal-sm">
        <div class="modal-header">
            <h3>Delete Teacher</h3>
            <button class="modal-close" onclick="closeModal('deleteModal')">×</button>
        </div>
        <div class="modal-body">
            <p>Are you sure you want to delete <strong id="deleteName"></strong>? This cannot be undone.</p>
        </div>
        <div class="modal-footer">
            <button class="btn-secondary" onclick="closeModal('deleteModal')">Cancel</button>
            <button class="btn-danger" id="confirmDeleteBtn" onclick="submitDelete()">Yes, Delete</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let currentPage  = @Model.CurrentPage;
    const totalPages = @Model.TotalPages;
    let isLoading = false, searchTimer = null, isEditing = false, pendingDeleteId = null;

    const antiForgery = document.querySelector('input[name="__RequestVerificationToken"]').value;

    // ── Lazy loading ─────────────────────────────────────────
    new IntersectionObserver(entries => {
        if (entries[0].isIntersecting && !isLoading && currentPage < totalPages) loadMore();
    }, { threshold: 0.1 }).observe(document.getElementById('loadSentinel'));

    async function loadMore() {
        isLoading = true;
        document.getElementById('lazySpinner').style.display = 'flex';
        const s = document.getElementById('searchInput').value;
        const f = document.getElementById('statusFilter').value;
        try {
            const res  = await fetch(`/Admin/TeachersPartial?page=${currentPage + 1}&search=${encodeURIComponent(s)}&status=${encodeURIComponent(f)}`);
            const html = await res.text();
            if (html.trim()) { document.getElementById('teachersBody').insertAdjacentHTML('beforeend', html); currentPage++; }
        } catch { Toast.error('Failed to load more teachers.'); }
        finally  { isLoading = false; document.getElementById('lazySpinner').style.display = 'none'; }
    }

    // ── Search — AJAX, no page redirect ─────────────────────
    function handleSearch() {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(async () => {
            const s = document.getElementById('searchInput').value;
            const f = document.getElementById('statusFilter').value;
            try {
                const res  = await fetch(`/Admin/TeachersPartial?page=1&search=${encodeURIComponent(s)}&status=${encodeURIComponent(f)}`);
                const html = await res.text();
                document.getElementById('teachersBody').innerHTML = html || emptyRow();
                currentPage = 1;
            } catch { Toast.error('Search failed.'); }
        }, 350);
    }

    function emptyRow() {
        return `<tr><td colspan="6" style="text-align:center;padding:40px;color:rgba(255,255,255,0.35)">No teachers found.</td></tr>`;
    }

    // ── Modals ───────────────────────────────────────────────
    function openAddModal() {
        isEditing = false;
        document.getElementById('modalTitle').textContent = 'Add Teacher';
        document.getElementById('accountFields').style.display = '';
        clearForm();
        openModal('teacherModal');
    }

    function editTeacher(id, tno, fn, ln, email) {
        isEditing = true;
        document.getElementById('modalTitle').textContent = 'Edit Teacher';
        document.getElementById('accountFields').style.display = 'none';
        document.getElementById('dbId').value       = id;
        document.getElementById('teacherNo').value  = tno;
        document.getElementById('firstName').value  = fn;
        document.getElementById('lastName').value   = ln;
        document.getElementById('email').value      = email;
        openModal('teacherModal');
    }

    function viewTeacher(id, name, tno, email, courses, username, isActive) {
        const status = isActive === 'true' ? 'Active' : 'Inactive';
        document.getElementById('viewBody').innerHTML = `
            <div class="profile-view">
                <div class="profile-avatar">${name.charAt(0)}</div>
                <h3 class="profile-name">${name}</h3>
                <p class="profile-id">${tno}</p>
                <div class="profile-details">
                    <div class="detail-row"><span class="detail-label">Email</span><span>${email}</span></div>
                    <div class="detail-row"><span class="detail-label">Courses</span><span>${courses} assigned</span></div>
                    <div class="detail-row"><span class="detail-label">Username</span><span>${username || '—'}</span></div>
                    <div class="detail-row"><span class="detail-label">Status</span>
                        <span class="status-badge ${status === 'Active' ? 'badge-active' : 'badge-inactive'}">${status}</span>
                    </div>
                </div>
            </div>`;
        openModal('viewModal');
    }

    function confirmDelete(id, name) {
        pendingDeleteId = id;
        document.getElementById('deleteName').textContent = name;
        openModal('deleteModal');
    }

    // ── AJAX Submit ──────────────────────────────────────────
    async function submitTeacher() {
        const fn  = document.getElementById('firstName').value.trim();
        const ln  = document.getElementById('lastName').value.trim();
        const em  = document.getElementById('email').value.trim();
        const tno = document.getElementById('teacherNo').value.trim();

        if (!fn || !ln || !em || !tno) { Toast.warning('Please fill in all required fields.'); return; }

        if (!isEditing) {
            const un = document.getElementById('username').value.trim();
            const pw = document.getElementById('password').value.trim();
            if (!un || !pw) { Toast.warning('Username and password are required.'); return; }
            if (pw.length < 6) { Toast.warning('Password must be at least 6 characters.'); return; }
        }

        const btn = document.getElementById('saveBtn');
        btn.disabled = true; btn.textContent = 'Saving...';

        const url     = isEditing ? '/Admin/UpdateTeacher' : '/Admin/AddTeacher';
        const payload = new URLSearchParams({
            __RequestVerificationToken: antiForgery,
            id:        document.getElementById('dbId').value,
            teacherNo: tno, firstName: fn, lastName: ln, email: em,
            username:  isEditing ? '' : document.getElementById('username').value.trim(),
            password:  isEditing ? '' : document.getElementById('password').value.trim(),
        });

        try {
            const res  = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
                body: payload
            });
            const data = await res.json();
            if (data.success) {
                Toast.success(data.message);
                closeModal('teacherModal');
                await refreshTable();
            } else {
                Toast.error(data.message);
            }
        } catch { Toast.error('An unexpected error occurred.'); }
        finally  { btn.disabled = false; btn.textContent = 'Save Teacher'; }
    }

    async function submitDelete() {
        const btn = document.getElementById('confirmDeleteBtn');
        btn.disabled = true; btn.textContent = 'Deleting...';

        const payload = new URLSearchParams({
            __RequestVerificationToken: antiForgery,
            id: pendingDeleteId
        });

        try {
            const res  = await fetch('/Admin/DeleteTeacher', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
                body: payload
            });
            const data = await res.json();
            if (data.success) {
                Toast.success(data.message);
                closeModal('deleteModal');
                const row = document.getElementById(`row-${pendingDeleteId}`);
                if (row) { row.style.transition = 'opacity 0.3s'; row.style.opacity = '0'; setTimeout(() => row.remove(), 300); }
            } else {
                Toast.error(data.message);
            }
        } catch { Toast.error('An unexpected error occurred.'); }
        finally  { btn.disabled = false; btn.textContent = 'Yes, Delete'; }
    }

    async function refreshTable() {
        const s = document.getElementById('searchInput').value;
        const f = document.getElementById('statusFilter').value;
        const res  = await fetch(`/Admin/TeachersPartial?page=1&search=${encodeURIComponent(s)}&status=${encodeURIComponent(f)}`);
        const html = await res.text();
        document.getElementById('teachersBody').innerHTML = html || emptyRow();
        currentPage = 1;
    }

    function clearForm() {
        ['dbId','teacherNo','firstName','lastName','email','username','password']
            .forEach(id => { const el = document.getElementById(id); if (el) el.value = ''; });
    }

    function openModal(id)  { document.getElementById(id).classList.add('active'); }
    function closeModal(id) { document.getElementById(id).classList.remove('active'); }
    document.querySelectorAll('.modal-overlay').forEach(o =>
        o.addEventListener('click', e => { if (e.target === o) o.classList.remove('active'); }));
    document.addEventListener('keydown', e => {
        if (e.key === 'Escape') document.querySelectorAll('.modal-overlay.active').forEach(m => m.classList.remove('active'));
    });
</script>
}
