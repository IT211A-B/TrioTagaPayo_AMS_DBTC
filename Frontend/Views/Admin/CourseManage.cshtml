@model AMS.ViewModels.CourseViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Course Management";
    ViewData["PageTitle"] = "Course Management";
    ViewData["ActivePage"] = "Courses";
}

@{
    var courseCode = Model.CourseCode ?? "";
    var courseName = Model.CourseName ?? "";
    var units = Model.Units;
    var courseSection = Model.Section ?? "";
    var schedule = Model.Schedule ?? "";
    var teacherId = Model.TeacherId;
    var dbId = Model.DbId;
    var hasTeachers = ViewBag.Teachers != null && ViewBag.Teachers.Count > 0;
}

<link rel="stylesheet" href="~/css/pages/courses.css" />

<div class="page-header">
    <div>
        <h2>Course Management</h2>
        <p>Edit course details and assignments</p>
    </div>
    <a href="@Url.Action("Courses", "Admin")" class="btn-secondary">← Back to Courses</a>
</div>

<div class="form-card">
    <form method="post" asp-action="CourseManage" asp-route-id="@dbId">
        @Html.AntiForgeryToken()

        <div class="form-row">
            <div class="form-group">
                <label>Course Code <span class="req">*</span></label>
                <input type="text" name="courseCode" class="form-input" value="@courseCode" required />
            </div>
            <div class="form-group">
                <label>Units <span class="req">*</span></label>
                <input type="number" name="units" class="form-input" value="@units" min="1" max="10" required />
            </div>
        </div>

        <div class="form-group">
            <label>Course Name <span class="req">*</span></label>
            <input type="text" name="courseName" class="form-input" value="@courseName" required />
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>Section <span class="req">*</span></label>
                <input type="text" name="section" class="form-input" value="@courseSection" required />
            </div>
            <div class="form-group">
                <label>Schedule <span class="req">*</span></label>
                <input type="text" name="schedule" class="form-input" value="@schedule" required />
            </div>
        </div>

        <div class="form-group">
            <label>Teacher <span class="req">*</span></label>
            <select name="teacherId" class="form-select" required>
                <option value="">— Select Teacher —</option>
                @if (hasTeachers)
                {
                    foreach (var teacher in ViewBag.Teachers)
                    {
                        if (teacher.Id == teacherId)
                        {
                            <option value="@teacher.Id" selected="selected">@teacher.Name (@teacher.TeacherNo)</option>
                        }
                        else
                        {
                            <option value="@teacher.Id">@teacher.Name (@teacher.TeacherNo)</option>
                        }
                    }
                }
            </select>
        </div>

        <div class="modal-footer" style="margin-top: 20px; padding: 0;">
            <a href="@Url.Action("Courses", "Admin")" class="btn-secondary">Cancel</a>
            <button type="submit" class="btn-primary">Save Changes</button>
        </div>
    </form>
</div>

<script>
    (function() {
        var form = document.querySelector('form');
        if (form) {
            form.addEventListener('submit', function(e) {
                var courseCodeInput = document.querySelector('input[name="courseCode"]');
                var courseNameInput = document.querySelector('input[name="courseName"]');
                var sectionInput = document.querySelector('input[name="section"]');
                var scheduleInput = document.querySelector('input[name="schedule"]');
                var teacherIdSelect = document.querySelector('select[name="teacherId"]');

                var codeValue = courseCodeInput ? courseCodeInput.value.trim() : '';
                var nameValue = courseNameInput ? courseNameInput.value.trim() : '';
                var sectionValue = sectionInput ? sectionInput.value.trim() : '';
                var scheduleValue = scheduleInput ? scheduleInput.value.trim() : '';
                var teacherValue = teacherIdSelect ? teacherIdSelect.value : '';

                if (!codeValue || !nameValue || !sectionValue || !scheduleValue || !teacherValue) {
                    e.preventDefault();
                    if (typeof Toast !== 'undefined') {
                        Toast.warning('Please fill in all required fields.');
                    } else {
                        alert('Please fill in all required fields.');
                    }
                }
            });
        }
    })();
</script>