@{
    Layout = null;
    ViewData["Title"] = "Student Login";
    string errorMsg = ViewBag.Error as string ?? "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no" />
    <title>Student Login - 3TagaPayu AMS</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/pages/student-login.css" />
</head>
<body>
    <div class="login-container">
        <div class="login-card">
            <div class="logo">
                <h1>3TagaPayu <span>AMS</span></h1>
                <p>Student Portal</p>
            </div>

            <div class="title">
                <h2>Welcome Student!</h2>
                <p>Enter your Student ID to view your attendance</p>
            </div>

            @if (!string.IsNullOrEmpty(errorMsg))
            {
                <div class="error-msg">
                    @("⚠️ " + errorMsg)
                </div>
            }

            <form method="post" asp-action="StudentLogin" asp-controller="Account">
                @Html.AntiForgeryToken()

                <div class="input-group">
                    <label>STUDENT ID</label>
                    <input type="text" name="username" placeholder="e.g., STU001 or 2024-00001" required autofocus />
                </div>

                <input type="hidden" name="password" value="auto-login" />

                <button type="submit" class="login-btn">LOGIN</button>
            </form>

            <div class="info-box">
                <strong>💡 First time here?</strong><br />
                Scan an attendance QR code from your teacher to create your account automatically.
            </div>

            <a href="@Url.Action("Login", "Account")" class="back-link">← Back to Admin/Teacher Login</a>

            <div class="footer">
                <p>3TagaPayu Attendance Management System</p>
            </div>
        </div>
    </div>
</body>
</html>