@model List<AMS.ViewModels.AttendanceEntryViewModel>
@{
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    ViewData["Title"] = "Attendance History";
    ViewData["PageTitle"] = "My Attendance History";
    ViewData["ActivePage"] = "History";
}

<div class="page-header">
    <div>
        <h2>Attendance History</h2>
        <p>View all your attendance records</p>
    </div>
</div>

<div class="filter-bar">
    <div class="search-wrapper">
        <svg class="search-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="10" cy="10" r="7" />
            <path d="M21 21L15 15" />
        </svg>
        <input type="text" id="searchInput" class="search-input" placeholder="Search by course..." />
    </div>
    <select id="courseFilter" class="filter-select">
        <option value="">All Courses</option>
        @if (ViewBag.Courses != null)
        {
            foreach (var course in ViewBag.Courses)
            {
                if (ViewBag.SelectedCourse != null && ViewBag.SelectedCourse.ToString() == course.ToString())
                {
                    <option value="@course" selected="selected">@course</option>
                }
                else
                {
                    <option value="@course">@course</option>
                }
            }
        }
    </select>
    <select id="statusFilter" class="filter-select">
        <option value="">All Status</option>
        <option value="Present">Present</option>
        <option value="Absent">Absent</option>
        <option value="Late">Late</option>
    </select>
    <button id="applyFilterBtn" class="btn-secondary">Apply Filter</button>
    <button id="resetFilterBtn" class="btn-secondary" style="background: rgba(255,255,255,0.05);">Reset</button>
</div>

@{
    var totalCount = Model.Count;
    var presentCount = Model.Count(x => x.Status == "Present");
    var absentCount = Model.Count(x => x.Status == "Absent");
    var lateCount = Model.Count(x => x.Status == "Late");
}

<div class="summary-bar">
    <div class="summary-pill"><span class="pill-dot dot-blue"></span>Total: <strong>@totalCount</strong></div>
    <div class="summary-pill"><span class="pill-dot dot-green"></span>Present: <strong>@presentCount</strong></div>
    <div class="summary-pill"><span class="pill-dot dot-red"></span>Absent: <strong>@absentCount</strong></div>
    <div class="summary-pill"><span class="pill-dot" style="background:#f59e0b"></span>Late: <strong>@lateCount</strong></div>
</div>

<div class="table-wrapper">
    <table class="data-table">
        <thead>
            <tr>
                <th>Course</th>
                <th>Date</th>
                <th>Status</th>
                <th>Remarks</th>
            </tr>
        </thead>
        <tbody id="attendanceBody">
            @if (Model.Any())
            {
                foreach (var a in Model)
                {
                    <tr class="table-row" data-course="@a.CourseName" data-status="@a.Status">
                        <td>@a.CourseName</td>
                        <td>@a.Date</td>
                        <td>
                            @if (a.Status == "Present")
                            {
                                <span class="status-badge badge-active">@a.Status</span>
                            }
                            else if (a.Status == "Late")
                            {
                                <span class="status-badge badge-warning">@a.Status</span>
                            }
                            else
                            {
                                <span class="status-badge badge-inactive">@a.Status</span>
                            }
                        </td>
                        <td>@(string.IsNullOrEmpty(a.Remarks) ? "—" : a.Remarks)</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4">
                        <div class="empty-state">
                            <span class="empty-icon">📋</span>
                            <p class="empty-title">No attendance records</p>
                            <p class="empty-message">Scan a QR code to mark your attendance.</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        (function() {
            var courseFilter = document.getElementById('courseFilter');
            var statusFilter = document.getElementById('statusFilter');
            var searchInput = document.getElementById('searchInput');
            var applyBtn = document.getElementById('applyFilterBtn');
            var resetBtn = document.getElementById('resetFilterBtn');
            var tableBody = document.getElementById('attendanceBody');
            var totalSpan = document.getElementById('totalCount');
            var presentSpan = document.getElementById('presentCount');
            var lateSpan = document.getElementById('lateCount');
            var absentSpan = document.getElementById('absentCount');

            function filterTable() {
                var selectedCourse = courseFilter ? courseFilter.value : '';
                var selectedStatus = statusFilter ? statusFilter.value : '';
                var searchTerm = searchInput ? searchInput.value.toLowerCase() : '';
                var rows = tableBody ? tableBody.querySelectorAll('tr.table-row') : [];
                var visibleCount = 0;
                var presentCountNum = 0;
                var lateCountNum = 0;
                var absentCountNum = 0;

                for (var i = 0; i < rows.length; i++) {
                    var row = rows[i];
                    var course = row.getAttribute('data-course') || '';
                    var status = row.getAttribute('data-status') || '';
                    var courseText = '';
                    var firstCell = row.cells[0];
                    if (firstCell) {
                        courseText = firstCell.textContent.toLowerCase();
                    }

                    var showCourse = !selectedCourse || course === selectedCourse;
                    var showStatus = !selectedStatus || status === selectedStatus;
                    var showSearch = !searchTerm || courseText.indexOf(searchTerm) !== -1;

                    if (showCourse && showStatus && showSearch) {
                        row.style.display = '';
                        visibleCount++;
                        if (status === 'Present') presentCountNum++;
                        else if (status === 'Late') lateCountNum++;
                        else if (status === 'Absent') absentCountNum++;
                    } else {
                        row.style.display = 'none';
                    }
                }

                if (totalSpan) totalSpan.textContent = visibleCount;
                if (presentSpan) presentSpan.textContent = presentCountNum;
                if (lateSpan) lateSpan.textContent = lateCountNum;
                if (absentSpan) absentSpan.textContent = absentCountNum;
            }

            function resetFilters() {
                if (courseFilter) courseFilter.value = '';
                if (statusFilter) statusFilter.value = '';
                if (searchInput) searchInput.value = '';
                filterTable();
            }

            if (applyBtn) applyBtn.addEventListener('click', filterTable);
            if (resetBtn) resetBtn.addEventListener('click', resetFilters);
            if (searchInput) searchInput.addEventListener('input', filterTable);
            if (courseFilter) courseFilter.addEventListener('change', filterTable);
            if (statusFilter) statusFilter.addEventListener('change', filterTable);

            filterTable();
        })();
    </script>
}