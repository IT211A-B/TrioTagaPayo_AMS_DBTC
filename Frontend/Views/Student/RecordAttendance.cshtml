@model AMS.ViewModels.RecordAttendanceViewModel
@{
    Layout = null;
    ViewData["Title"] = "Record Attendance";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Record Attendance - 3TagaPayu AMS</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/pages/record-attendance.css" />
</head>
<body>
    <div class="card">
        <h1>📷 Record Attendance</h1>
        <p class="subtitle">Scan successful! Please confirm your details.</p>

        <div class="course-info">
            <p>Course ID: <strong>@Model.CourseId</strong></p>
            <p>Date: <strong>@Model.Date</strong></p>
        </div>

        <form id="attendanceForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="courseId" value="@Model.CourseId" />
            <input type="hidden" name="date" value="@Model.Date" />

            <div class="form-group">
                <label>STUDENT ID / NUMBER</label>
                <input type="text" id="studentId" name="studentId" placeholder="e.g., STU001 or 2024-00001" required />
            </div>

            <div class="form-group">
                <label>FULL NAME</label>
                <input type="text" id="studentName" name="studentName" placeholder="e.g., Juan Dela Cruz" required />
            </div>

            <button type="submit" id="submitBtn">✓ MARK ATTENDANCE</button>
        </form>

        <div id="message" class="message"></div>

        <div class="login-link">
            Already have an account? <a href="/Account/StudentLogin">Login here</a>
        </div>
    </div>

    <script src="~/js/pages/record-attendance.js"></script>
</body>
</html>